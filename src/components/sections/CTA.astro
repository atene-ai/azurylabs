---
import Button from "../ui/Button.astro";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="cta" id="contacto">
  <!-- Background glow -->
  <div class="cta__glow" aria-hidden="true"></div>

  <div class="container cta__inner">
    <div class="cta__content">
      <p class="cta__overline">{t("cta.overline")}</p>

      <h2 class="cta__title" set:html={t("cta.title")} />

      <p class="cta__sub">
        {t("cta.sub")}
      </p>

      <div class="cta__actions">
        <Button variant="primary" size="lg" href={t("cta.link")}>
          {t("cta.primary")}
        </Button>
        <Button variant="ghost" size="lg" href="#productos">
          {t("cta.secondary")}
        </Button>
      </div>

      <p class="cta__disclaimer">
        {t("cta.disclaimer")}
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: var(--space-32);
    position: relative;
    overflow: hidden;
  }

  .cta__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 60% 50% at 50% 50%,
        rgba(139, 92, 246, 0.12) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 40% 40% at 20% 80%,
        rgba(59, 130, 246, 0.08) 0%,
        transparent 60%
      );
    pointer-events: none;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
  }

  .cta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
    max-width: 640px;
    margin-inline: auto;
  }

  .cta__overline {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-brand);
  }

  .cta__title {
    font-family: var(--font-brand);
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  :global(.cta__title--accent) {
    background: linear-gradient(
      135deg,
      var(--color-brand) 0%,
      var(--color-glow) 50%,
      var(--color-blue) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cta__sub {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 480px;
  }

  .cta__actions {
    display: flex;
    gap: var(--space-4);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .cta__disclaimer {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-faint);
    margin-top: var(--space-2);
  }
</style>
