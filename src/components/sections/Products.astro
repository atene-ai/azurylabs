---
import Badge from "../ui/Badge.astro";
import BackgroundGlow from "../ui/BackgroundGlow.astro";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = [
  {
    id: "atenea",
    number: "01",
    badge: t("products.atenea.badge"),
    badgeVariant: "brand",
    title: t("products.atenea.title"),
    description: t("products.atenea.desc"),
    features: t("products.atenea.features"),
    cta: t("products.atenea.cta"),
    href: "https://v3.atenea.iruzlabs.com",
    logo: "/images/logos/iruzlabs-atenea-logo.png",
    logoAlt: "Iruz Atenea",
    logoWidth: 745,
    logoHeight: 537,
    wordmark: null,
    tone: "violet",
  },
  {
    id: "lindex",
    number: "02",
    badge: t("products.lindex.badge"),
    badgeVariant: "glow",
    title: t("products.lindex.title"),
    description: t("products.lindex.desc"),
    features: t("products.lindex.features"),
    cta: t("products.lindex.cta"),
    href: "https://lindex.iruzlabs.com",
    logo: "/images/logos/lindex-logo.png",
    logoAlt: "Lindex by Iruz Labs",
    logoWidth: 1853,
    logoHeight: 594,
    wordmark: null,
    tone: "ice",
  },
  {
    id: "sales-os",
    number: "03",
    badge: t("products.salesOs.badge"),
    badgeVariant: "blue",
    title: t("products.salesOs.title"),
    description: t("products.salesOs.desc"),
    features: t("products.salesOs.features"),
    cta: t("products.salesOs.cta"),
    href: "https://crm.iruzlabs.com",
    logo: null,
    logoAlt: "",
    logoWidth: 0,
    logoHeight: 0,
    wordmark: "SALES OS",
    tone: "navy",
  },
  {
    id: "mi-negocio",
    number: "04",
    badge: t("products.miNegocio.badge"),
    badgeVariant: "glow",
    title: t("products.miNegocio.title"),
    description: t("products.miNegocio.desc"),
    features: t("products.miNegocio.features"),
    cta: t("products.miNegocio.cta"),
    href: `https://minegocio.iruzlabs.com/${lang}`,
    logo: null,
    logoAlt: "",
    logoWidth: 0,
    logoHeight: 0,
    wordmark: "MI NEGOCIO",
    tone: "cyan",
  },
  {
    id: "ciee",
    number: "05",
    badge: t("products.ciee.badge"),
    badgeVariant: "brand",
    title: t("products.ciee.title"),
    description: t("products.ciee.desc"),
    features: t("products.ciee.features"),
    cta: t("products.ciee.cta"),
    href: "https://ciee.iruzlabs.com",
    logo: "/images/logos/iruzlabs-ciee-logo.png",
    logoAlt: "Iruz CIEE",
    logoWidth: 1871,
    logoHeight: 512,
    wordmark: null,
    tone: "ice",
  },
  {
    id: "systems",
    number: "06",
    badge: t("products.systems.badge"),
    badgeVariant: "blue",
    title: t("products.systems.title"),
    description: t("products.systems.desc"),
    features: t("products.systems.features"),
    cta: t("products.systems.cta"),
    href: "https://systems.iruzlabs.com",
    logo: null,
    logoAlt: "",
    logoWidth: 0,
    logoHeight: 0,
    wordmark: "SYSTEMS",
    tone: "graphite",
  },
];
---

<section class="products" id="productos">
  <BackgroundGlow role="glow" size="760px" top="-180px" right="-240px" blur="130px" />

  <div class="container products__inner">
    <header class="products__header reveal">
      <Badge variant="subtle">{t("products.header.badge")}</Badge>
      <h2 class="products__title" set:html={t("products.header.title")} />
      <p class="products__sub">{t("products.header.sub")}</p>
    </header>

    <div class="products__grid">
      {products.map((product, index) => (
        <article
          class:list={[
            "product-card",
            `product-card--${product.tone}`,
            index < 2 && "product-card--featured",
            "reveal",
          ]}
          style={`transition-delay: ${index * 70}ms`}
        >
          <div class="product-card__media">
            <span class="product-card__number">{product.number}</span>
            {product.logo ? (
              <img
                class:list={["product-card__logo", `product-card__logo--${product.id}`]}
                src={product.logo}
                alt={product.logoAlt}
                width={product.logoWidth}
                height={product.logoHeight}
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div
                class:list={["product-card__wordmark", `product-card__wordmark--${product.id}`]}
                aria-label={`Iruz ${product.wordmark}`}
              >
                <img src="/images/logos/iruzlabs-isotipo-light.png" alt="" width="512" height="512" loading="lazy" />
                <span>
                  <small>IRUZ</small>
                  <strong>{product.wordmark}</strong>
                </span>
              </div>
            )}
          </div>

          <div class="product-card__content">
            <Badge variant={product.badgeVariant as any}>{product.badge}</Badge>
            <h3>{product.title}</h3>
            <p>{product.description}</p>

            <ul>
              {Array.isArray(product.features) && product.features.map((feature: string) => (
                <li><span aria-hidden="true">✓</span>{feature}</li>
              ))}
            </ul>

            <a href={product.href} target="_blank" rel="noopener noreferrer">
              {product.cta}<span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .products {
    position: relative;
    overflow: hidden;
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .products__inner { position: relative; z-index: 1; }

  .products__header {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.55fr);
    align-items: end;
    gap: var(--space-5) var(--space-12);
    margin-bottom: clamp(2.8rem, 6vw, 5rem);
  }

  .products__header > :global(:first-child) { grid-column: 1 / -1; justify-self: start; }

  .products__title {
    color: var(--color-text);
    font-family: var(--font-brand);
    font-size: clamp(2.45rem, 5vw, 4.7rem);
    font-weight: var(--weight-bold);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  :global(.products__title--accent) {
    background: linear-gradient(120deg, var(--color-brand), var(--color-glow));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .products__sub {
    max-width: 46ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .product-card {
    grid-column: span 4;
    container-type: inline-size;
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: clamp(1.2rem, 2.4vw, 1.8rem);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .product-card:nth-child(1) { grid-column: span 7; }
  .product-card:nth-child(2) { grid-column: span 5; }
  .product-card:nth-child(6) { grid-column: 1 / -1; }

  @media (min-width: 961px) {
    .product-card:nth-child(6) { flex-direction: row; }
    .product-card:nth-child(6) .product-card__media {
      flex: 0 0 38%;
      border-right: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 0;
    }
    .product-card:nth-child(6) .product-card__content > a { padding-top: var(--space-5); }
  }

  .product-card:hover {
    transform: translateY(-6px);
    border-color: color-mix(in srgb, var(--color-brand) 42%, var(--color-border));
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28), 0 0 34px color-mix(in srgb, var(--color-brand) 10%, transparent);
  }

  .product-card__media {
    position: relative;
    display: flex;
    min-height: 190px;
    align-items: center;
    justify-content: center;
    padding: clamp(1.5rem, 4vw, 3rem);
    overflow: hidden;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .product-card--featured .product-card__media { min-height: 245px; }
  .product-card--violet .product-card__media { background: linear-gradient(145deg, #f2edff, #dcd0ff); }
  .product-card--navy .product-card__media { background: linear-gradient(145deg, #0b1629, #0c3150); }
  .product-card--cyan .product-card__media { background: linear-gradient(145deg, #072338, #09617c); }
  .product-card--ice .product-card__media { background: linear-gradient(145deg, #f4fbff, #d8effc); }
  .product-card--graphite .product-card__media { background: linear-gradient(145deg, #0b111d, #273142); }

  .product-card__number {
    position: absolute;
    top: 1rem;
    right: 1.1rem;
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.67rem;
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  .product-card--violet .product-card__number,
  .product-card--ice .product-card__number { color: rgba(15, 31, 62, 0.48); }

  .product-card__logo {
    display: block;
    width: auto;
    max-width: 80%;
    max-height: 138px;
    object-fit: contain;
    filter: drop-shadow(0 10px 18px rgba(18, 28, 55, 0.12));
  }

  .product-card__logo--atenea { max-width: min(72%, 290px); }
  .product-card__logo--ciee { max-width: 92%; max-height: 120px; }
  .product-card__logo--lindex { max-width: min(82%, 340px); }

  .product-card__wordmark {
    display: flex;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2.5vw, 1.7rem);
    color: #f3f8fd;
  }

  .product-card__wordmark > img {
    width: clamp(62px, 8vw, 96px);
    height: clamp(62px, 8vw, 96px);
    object-fit: contain;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.32));
  }

  .product-card__wordmark span { display: flex; flex-direction: column; gap: 0.2rem; }
  .product-card__wordmark small { color: #6fe3ff; font-size: 0.67rem; font-weight: 750; letter-spacing: 0.22em; }
  .product-card__wordmark strong {
    font-family: var(--font-brand);
    font-size: clamp(1.7rem, 3.8vw, 3.1rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
    white-space: nowrap;
  }

  .product-card:not(.product-card--featured) .product-card__media {
    padding-inline: 1.25rem;
  }

  .product-card__wordmark--mi-negocio,
  .product-card__wordmark--systems {
    gap: clamp(0.7rem, 1.2vw, 0.95rem);
  }

  .product-card__wordmark--mi-negocio > img,
  .product-card__wordmark--systems > img {
    width: clamp(48px, 19cqi, 72px);
    height: clamp(48px, 19cqi, 72px);
  }

  .product-card__wordmark--mi-negocio span,
  .product-card__wordmark--systems span {
    gap: 0.12rem;
  }

  .product-card__wordmark--mi-negocio small,
  .product-card__wordmark--systems small {
    font-size: 0.56rem;
  }

  .product-card__wordmark--mi-negocio strong,
  .product-card__wordmark--systems strong {
    font-size: clamp(1.25rem, 8cqi, 2rem);
    letter-spacing: -0.035em;
  }

  .product-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.35rem, 3vw, 2.25rem);
  }

  .product-card__content h3 {
    margin-top: var(--space-5);
    color: var(--color-text);
    font-family: var(--font-brand);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .product-card__content > p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .product-card__content ul {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .product-card__content li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .product-card__content li span { color: var(--color-brand); font-weight: 700; }

  .product-card__content > a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: var(--space-6);
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .product-card__content > a span { transition: transform var(--duration-fast) var(--ease-out); }
  .product-card__content > a:hover { color: var(--color-text); }
  .product-card__content > a:hover span { transform: translate(3px, -3px); }

  :global(:root[data-theme="light"]) .product-card {
    background: rgba(255, 255, 255, 0.94);
    border-color: rgba(15, 23, 42, 0.1);
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
  }

  @media (max-width: 960px) {
    .products__header { grid-template-columns: 1fr; align-items: start; }
    .products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-card,
    .product-card:nth-child(1),
    .product-card:nth-child(2) { grid-column: span 1; }
    .product-card:last-child { grid-column: 1 / -1; }
    .product-card__media,
    .product-card--featured .product-card__media { min-height: 215px; }
  }

  @media (max-width: 640px) {
    .products { padding-block: var(--space-20); }
    .products__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .product-card,
    .product-card:last-child { grid-column: 1; }
    .product-card__media,
    .product-card--featured .product-card__media { min-height: 190px; }
    .product-card__logo--ciee { max-width: 100%; }
  }
</style>
