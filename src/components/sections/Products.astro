---
import "../../styles/product-palettes.css";
import Badge from "../ui/Badge.astro";
import ProductMedia from "../ui/ProductMedia.astro";
import { getProducts } from "../../lib/products";
import BackgroundGlow from "../ui/BackgroundGlow.astro";
import { useTranslations } from "../../i18n/utils";
import { isExternal } from "../../lib/product-links";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const products = getProducts(lang);
---

<section class="products" id="productos">
  <BackgroundGlow role="glow" size="760px" top="-180px" right="-240px" blur="130px" />

  <div class="container products__inner">
    <header class="products__header reveal">
      <Badge variant="subtle">{t("products.header.badge")}</Badge>
      <h2 class="products__title" set:html={t("products.header.title")} />
      <p class="products__sub">{t("products.header.sub")}</p>
    </header>

    <div class="products__grid">
      {products.map((product, index) => (
        <article
          class:list={[
            "product-card",
            `product-card--${product.id}`,
            index < 2 && "product-card--featured",
            "reveal",
          ]}
          data-product-motion
          style={`--product-accent:${product.artwork.accent}`}
        >
          <ProductMedia product={product} featured={index < 2} mirrored={index % 2 === 1} />

          <div class="product-card__content">
            <Badge variant={product.badgeVariant as any}>{product.badge}</Badge>
            <h3>{product.title}</h3>
            <p>{product.description}</p>

            <ul>
              {Array.isArray(product.features) && product.features.map((feature: string) => (
                <li><span aria-hidden="true">✓</span>{feature}</li>
              ))}
            </ul>

            <a
              href={product.href}
              target={isExternal(product.href) ? "_blank" : undefined}
              rel={isExternal(product.href) ? "noopener noreferrer" : undefined}
            >
              {product.cta}<span aria-hidden="true">{isExternal(product.href) ? "↗" : "→"}</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .products {
    position: relative;
    overflow: hidden;
    padding-block: clamp(6rem, 10vw, 9rem);
  }

  .products__inner { position: relative; z-index: 1; }

  .products__header {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(300px, 0.55fr);
    align-items: end;
    gap: var(--space-5) var(--space-12);
    margin-bottom: clamp(2.8rem, 6vw, 5rem);
  }

  .products__header > :global(:first-child) { grid-column: 1 / -1; justify-self: start; }

  .products__title {
    color: var(--color-text);
    font-family: var(--font-brand);
    font-size: clamp(2.45rem, 5vw, 4.7rem);
    font-weight: var(--weight-bold);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }

  :global(.products__title--accent) {
    background: linear-gradient(120deg, var(--color-brand), var(--color-glow));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .products__sub {
    max-width: 46ch;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: 1.65;
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .product-card {
    --product-surface: #0b1025;
    grid-column: span 4;
    container-type: inline-size;
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: clamp(1.2rem, 2.4vw, 1.8rem);
    background: var(--product-surface);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .product-card:nth-child(1) { grid-column: span 7; }
  .product-card:nth-child(2) { grid-column: span 5; }

  .product-card:is(:hover, :focus-within) {
    transform: translateY(-6px);
    border-color: var(--product-accent);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.28), 0 12px 38px color-mix(in srgb, var(--product-accent) 24%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card,
    .product-card__content > a span { transition: none; }
    .product-card.reveal { opacity: 1; transform: none; }
    .product-card:is(:hover, :focus-within) { transform: none; }
  }

  .product-card__content {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.35rem, 3vw, 2.25rem);
  }

  .product-card__content h3 {
    margin-top: var(--space-5);
    color: var(--color-text);
    font-family: var(--font-brand);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .product-card__content > p {
    margin-top: var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .product-card__content ul {
    display: grid;
    gap: 0.55rem;
    width: 100%;
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .product-card__content li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .product-card__content li span { color: var(--color-brand); font-weight: 700; }

  .product-card__content > a {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: auto;
    padding-top: var(--space-6);
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  .product-card__content > a span { transition: transform var(--duration-fast) var(--ease-out); }
  .product-card__content > a:hover { color: var(--color-text); }
  .product-card__content > a:hover span { transform: translate(3px, -3px); }

  :global(:root[data-theme="light"]) .product-card {
    border-color: rgba(15, 23, 42, 0.1);
    box-shadow: 0 18px 42px rgba(15, 23, 42, 0.1);
  }

  @media (max-width: 960px) {
    .products__header { grid-template-columns: 1fr; align-items: start; }
    .products__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .product-card,
    .product-card:nth-child(1),
    .product-card:nth-child(2) { grid-column: span 1; }
  }

  @media (max-width: 640px) {
    .products { padding-block: var(--space-20); }
    .products__grid { grid-template-columns: 1fr; gap: var(--space-4); }
    .product-card { grid-column: 1; }
  }
</style>
