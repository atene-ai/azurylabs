---
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const links = [
  {
    heading: t("footer.cols.products"),
    items: [
      { label: "Iruz Atenea", href: "https://v3.atenea.iruzlabs.com" },
      { label: "Iruz Lindex", href: "https://lindex.iruzlabs.com" },
      { label: "Iruz Sales OS", href: "https://crm.iruzlabs.com" },
      { label: "Iruz Mi Negocio", href: `https://minegocio.iruzlabs.com/${lang}` },
      { label: "Iruz CIEE", href: "https://ciee.iruzlabs.com" },
      { label: "Iruz Systems", href: "https://systems.iruzlabs.com" },
    ],
  },
  {
    heading: t("footer.cols.company"),
    items: [
      { label: t("footer.links.about"), href: `/${lang}/acerca` },
      { label: t("footer.links.team"), href: `/${lang}/acerca#equipo` },
      { label: t("footer.links.contact"), href: `/${lang}/acerca#contacto` },
      { label: t("footer.links.help"), href: `/${lang}/contacto` },
      { label: t("footer.links.blog"), href: `/${lang}/blog` },
    ],
  },
  {
    heading: t("footer.cols.legal"),
    items: [
      { label: t("footer.links.privacy"), href: `/${lang}/privacidad` },
      { label: t("footer.links.terms"), href: `/${lang}/terminos` },
    ],
  },
];

const year = new Date().getFullYear();
const copyright = t("footer.copy").replace("{year}", String(year));
// Force HMR update
---

<footer class="footer">
  <div class="container">
    <div class="footer__panel">
      <div class="footer__top">
        <!-- Brand -->
        <div class="footer__brand">
          <a
            href={`/${lang}/`}
            class="footer__logo"
            aria-label="Iruz Labs SAS de CV"
          >
            <img
              src="/images/logos/iruzlabs-logotipo-h-white.png"
              alt="Iruz Labs"
              class="footer__logo-img"
              width="200"
              height="58"
              loading="lazy"
            />
          </a>
          <p class="footer__tagline">
            {t("footer.tagline")}
          </p>
          <div class="footer__status">
            <span class="status__dot"></span>
            <span class="status__text">{t("footer.status")}</span>
          </div>
          <div class="footer__socials">
            <a
              href="https://www.facebook.com/profile.php?id=61588787630828"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Facebook"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"
                ></path></svg
              >
            </a>
            <a
              href="https://www.linkedin.com/company/iruzlabs"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="LinkedIn"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path><rect x="2" y="9" width="4" height="12"></rect><circle
                  cx="4"
                  cy="4"
                  r="2"></circle></svg
              >
            </a>
            <a
              href="https://www.instagram.com/iruzlabsmx/"
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label="Instagram"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                ></rect><path
                  d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg
              >
            </a>
          </div>
        </div>

        <!-- Links -->
        <nav class="footer__nav" aria-label="Footer navigation">
          {
            links.map((col) => (
              <div class="footer__col">
                <h4 class="footer__col-heading">{col.heading}</h4>
                <ul class="footer__col-list">
                  {col.items.map((item) => (
                    <li>
                      <a href={item.href} class="footer__link">
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>

      <div class="footer__bottom">
        <p class="footer__copy" set:html={copyright} />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: clamp(var(--space-12), 7vw, var(--space-20));
    padding-bottom: var(--space-10);
    position: relative;
  }

  .footer__panel {
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-xl) + 2px);
    background:
      radial-gradient(
        circle at 12% 12%,
        color-mix(in srgb, var(--color-brand) 10%, transparent),
        transparent 38%
      ),
      radial-gradient(
        circle at 90% 92%,
        color-mix(in srgb, var(--color-blue) 10%, transparent),
        transparent 44%
      ),
      var(--color-surface);
    padding: var(--space-10) var(--space-8) var(--space-6);
  }

  /* ── Top ── */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(240px, 290px) 1fr;
    gap: var(--space-16);
    margin-bottom: var(--space-12);
  }

  /* ── Brand ── */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__logo {
    display: inline-block;
    text-decoration: none;
    margin-bottom: var(--space-2);
  }

  .footer__logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 14px rgba(0, 200, 255, 0.22));
    transition: filter var(--duration-fast) var(--ease-out);
  }

  .footer__logo:hover .footer__logo-img {
    filter: drop-shadow(0 0 20px rgba(0, 200, 255, 0.4));
  }

  :global(:root[data-theme="light"]) .footer__logo-img {
    content: url("/images/logos/iruzlabs-logotipo-h-black.png");
    filter: drop-shadow(0 0 12px rgba(8, 145, 178, 0.18));
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 260px;
  }

  .footer__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
  }

  .status__text {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* ── Socials ── */
  .footer__socials {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .social-link {
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-surface-2) 78%, transparent);
    border-radius: var(--radius-full);
    width: 34px;
    height: 34px;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-link:hover {
    color: var(--color-brand);
    border-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
    transform: translateY(-2px);
  }

  /* ── Nav ── */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__col-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .footer__col-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    display: inline-flex;
  }

  .footer__link:hover {
    color: var(--color-text);
    transform: translateX(2px);
  }

  /* ── Bottom ── */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer__copy {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  :global(:root[data-theme="light"]) .footer__panel {
    background:
      radial-gradient(
        circle at 12% 12%,
        rgba(8, 145, 178, 0.08),
        transparent 40%
      ),
      radial-gradient(
        circle at 90% 92%,
        rgba(37, 99, 235, 0.07),
        transparent 46%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.94),
        rgba(245, 248, 253, 0.96)
      );
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .footer__panel {
      padding: var(--space-8) var(--space-6) var(--space-5);
    }

    .footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: var(--space-10);
      padding-bottom: var(--space-6);
    }

    .footer__panel {
      padding: var(--space-6) var(--space-4) var(--space-4);
      border-radius: var(--radius-lg);
    }

    .footer__top {
      gap: var(--space-7);
      margin-bottom: var(--space-7);
    }

    .footer__brand {
      align-items: center;
      text-align: center;
      gap: var(--space-3);
    }

    .footer__tagline {
      max-width: 32ch;
      font-size: var(--text-xs);
    }

    .footer__status {
      justify-content: center;
    }

    .footer__socials {
      justify-content: center;
      margin-top: 0;
    }

    .footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .footer__col {
      gap: var(--space-2);
      padding: var(--space-3);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--color-surface-2) 68%, transparent);
    }

    .footer__col:first-child {
      grid-column: 1 / -1;
    }

    .footer__col:first-child .footer__col-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-3);
    }

    .footer__col:first-child .footer__link {
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
    }
  }

  @media (max-width: 480px) {
    .footer__nav {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .footer__col {
      gap: var(--space-2);
    }

    .footer__link {
      font-size: var(--text-sm);
    }

    .footer__col:first-child .footer__col-list {
      flex-direction: column;
      gap: var(--space-2);
    }

    .footer__bottom {
      justify-content: center;
      text-align: center;
      padding-top: var(--space-4);
    }

    .footer__copy {
      width: 100%;
    }
  }
</style>
