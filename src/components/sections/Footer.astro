---
// Footer unificado del grupo Iruz Labs. El contenido sale de
// `iruz-labs-footer.ts` (copia idéntica en todos los sitios); aquí solo se
// declara lo propio de este sitio en `SITE`. Usa los tokens de diseño del
// sitio, así que respeta su tema claro/oscuro.
import { buildFooter, footerLang, type FooterSite } from "../../lib/iruz-labs-footer";

export interface Props {
  lang: string;
}

const SITE: FooterSite = {
  // Marca hermana: mismo footer con su propia marca y páginas. No muestra
  // alianzas, NVIDIA Inception ni «Hecho en México» (membresías de Iruz Labs).
  brand: "azurylabs",
  companyOrigin: "",
  legal: { privacy: "/{lang}/privacidad", terms: "/{lang}/terminos" },
};

const footer = buildFooter(footerLang(Astro.props.lang), SITE);
const { copy, brand, badges } = footer;
---

<footer class="footer">
  <div class="container">
    <div class="footer__panel">
      <div class="footer__top">
        <!-- Brand -->
        <div class="footer__brand">
          <a href={footer.homeHref} class="footer__logo" aria-label={brand.entity}>
            <img
              src={brand.logoDark}
              alt={brand.name}
              class="footer__logo-img footer__on-dark"
              width="200"
              height="58"
              loading="lazy"
            />
            <img
              src={brand.logoLight}
              alt={brand.name}
              class="footer__logo-img footer__on-light"
              width="200"
              height="58"
              loading="lazy"
            />
          </a>
          <p class="footer__tagline">{copy.tagline}</p>
          <div class="footer__status">
            <span class="status__dot"></span>
            <span class="status__text">{copy.status}</span>
          </div>
          <div class="footer__socials">
            {
              footer.socials.map((social) => (
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-link"
                  aria-label={social.label}
                  set:html={social.icon}
                />
              ))
            }
          </div>
        </div>

        <!-- Links -->
        <nav class="footer__nav" aria-label={copy.navLabel}>
          {
            footer.columns.map((col) => (
              <div class="footer__col">
                <h4 class="footer__col-heading">{col.heading}</h4>
                <ul class="footer__col-list">
                  {col.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class:list={["footer__link", { "footer__link--current": item.current }]}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>

      {
        footer.showMemberships && (
          <div class="footer__alliances">
            <div class="footer__alliances-group">
              <p class="footer__alliances-label">{copy.alliances}</p>
              <ul class="footer__partners">
                {footer.partners.map(({ icon, name, status }) => (
                  <li class="footer__partner" title={`${name} ${status}`}>
                    <span class="footer__partner-logo" set:html={icon} />
                    <span>{name}</span>
                  </li>
                ))}
                <li class="footer__partner">
                  <a
                    href={badges.elevenLabs.href}
                    class="footer__grants"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={badges.elevenLabs.srcDark}
                      alt={badges.elevenLabs.alt}
                      class="footer__grants-logo footer__on-dark"
                      width={badges.elevenLabs.width}
                      height={badges.elevenLabs.height}
                      loading="lazy"
                      decoding="async"
                    />
                    <img
                      src={badges.elevenLabs.srcLight}
                      alt={badges.elevenLabs.alt}
                      class="footer__grants-logo footer__on-light"
                      width={badges.elevenLabs.width}
                      height={badges.elevenLabs.height}
                      loading="lazy"
                      decoding="async"
                    />
                  </a>
                </li>
                {
                  footer.showMexicoSeals && (
                    <li class="footer__partner">
                      <a
                        href={badges.asem.href}
                        class="footer__seal"
                        target="_blank"
                        rel="noopener"
                        aria-label={copy.asemLabel}
                      >
                        <img
                          src={badges.asem.src}
                          alt={copy.asemAlt}
                          width={badges.asem.width}
                          height={badges.asem.height}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    </li>
                  )
                }
              </ul>
            </div>
            <div class="footer__inception">
              <p class="footer__inception-label">{copy.programs}</p>
              <div class="footer__inception-badges">
                <a
                  href={badges.nvidiaInception.href}
                  class="footer__inception-link"
                  target="_blank"
                  rel="noopener"
                  title={copy.inception}
                >
                  <img
                    src={badges.nvidiaInception.src}
                    alt={badges.nvidiaInception.alt}
                    width={badges.nvidiaInception.width}
                    height={badges.nvidiaInception.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <a
                  href={badges.microsoftPartner.href}
                  class="footer__inception-link footer__ms-partner-link"
                  target="_blank"
                  rel="noopener noreferrer"
                  title={copy.microsoftPartner}
                >
                  <img
                    src={badges.microsoftPartner.srcDark}
                    alt={badges.microsoftPartner.alt}
                    class="footer__ms-partner-logo footer__on-dark"
                    width={badges.microsoftPartner.width}
                    height={badges.microsoftPartner.height}
                    loading="lazy"
                    decoding="async"
                  />
                  <img
                    src={badges.microsoftPartner.srcLight}
                    alt={badges.microsoftPartner.alt}
                    class="footer__ms-partner-logo footer__on-light"
                    width={badges.microsoftPartner.width}
                    height={badges.microsoftPartner.height}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              </div>
            </div>
          </div>
        )
      }

      <div class="footer__bottom">
        <p class="footer__copy">{footer.copyright}</p>
        {
          footer.showMexicoSeals && (
            <div class="footer__origin">
              <img
                src={badges.madeInMexico.srcDark}
                alt={copy.madeInMexico}
                class="footer__origin-logo footer__on-dark"
                width={badges.madeInMexico.width}
                height={badges.madeInMexico.height}
                loading="lazy"
                decoding="async"
              />
              <img
                src={badges.madeInMexico.srcLight}
                alt={copy.madeInMexico}
                class="footer__origin-logo footer__on-light"
                width={badges.madeInMexico.width}
                height={badges.madeInMexico.height}
                loading="lazy"
                decoding="async"
              />
            </div>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-subtle);
    padding-top: clamp(var(--space-12), 7vw, var(--space-20));
    padding-bottom: var(--space-10);
    position: relative;
  }

  /* Variantes por tema: logos que tienen versión para fondo claro y oscuro. */
  .footer__on-light {
    display: none;
  }

  :global(:root[data-theme="light"]) .footer__on-dark {
    display: none;
  }

  :global(:root[data-theme="light"]) .footer__on-light {
    display: block;
  }

  .footer__panel {
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-xl) + 2px);
    background:
      radial-gradient(
        circle at 12% 12%,
        color-mix(in srgb, var(--color-brand) 10%, transparent),
        transparent 38%
      ),
      radial-gradient(
        circle at 90% 92%,
        color-mix(in srgb, var(--color-blue) 10%, transparent),
        transparent 44%
      ),
      var(--color-surface);
    padding: var(--space-10) var(--space-8) var(--space-6);
  }

  /* ── Top ── */
  .footer__top {
    display: grid;
    grid-template-columns: minmax(240px, 290px) 1fr;
    gap: var(--space-16);
    margin-bottom: var(--space-12);
  }

  /* ── Brand ── */
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__logo {
    display: inline-block;
    text-decoration: none;
    margin-bottom: var(--space-2);
  }

  .footer__logo-img {
    height: 52px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 14px rgba(0, 200, 255, 0.22));
    transition: filter var(--duration-fast) var(--ease-out);
  }

  .footer__logo:hover .footer__logo-img {
    filter: drop-shadow(0 0 20px rgba(0, 200, 255, 0.4));
  }

  :global(:root[data-theme="light"]) .footer__logo-img {
    filter: drop-shadow(0 0 12px rgba(8, 145, 178, 0.18));
  }

  .footer__tagline {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 260px;
  }

  .footer__status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .status__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    flex-shrink: 0;
  }

  .status__text {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  /* ── Socials ── */
  .footer__socials {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .social-link {
    color: var(--color-text-muted);
    border: 1px solid var(--color-border-subtle);
    background: color-mix(in srgb, var(--color-surface-2) 78%, transparent);
    border-radius: var(--radius-full);
    width: 34px;
    height: 34px;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .social-link:hover {
    color: var(--color-brand);
    border-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
    transform: translateY(-2px);
  }

  /* ── Nav ── */
  .footer__nav {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-10);
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .footer__col-heading {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .footer__col-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
    display: inline-flex;
    align-items: center;
  }

  .footer__link:hover {
    color: var(--color-text);
    transform: translateX(2px);
  }

  /* Producto propio del sitio: primero y con el color de la marca. */
  .footer__link--current {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
  }

  .footer__link--current::before {
    content: "";
    width: 6px;
    height: 6px;
    margin-right: var(--space-2);
    border-radius: 50%;
    background: var(--color-brand);
    flex-shrink: 0;
  }

  /* ── Alianzas ── */
  /* Dos bloques con su propio título: alianzas (izquierda) y NVIDIA Inception
     (derecha). En móvil se apilan. */
  .footer__alliances {
    --partner-width: 140px;
    --partner-height: 40px;
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5) var(--space-8);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
  }

  .footer__alliances-group {
    display: flex;
    flex: 1 1 420px;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .footer__alliances-label,
  .footer__inception-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .footer__partners {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-8);
  }

  .footer__partner {
    display: inline-flex;
    min-height: var(--partner-height);
    max-width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-text-muted);
    filter: grayscale(1);
    opacity: 0.75;
    transition:
      filter var(--duration-normal) var(--ease-out),
      opacity var(--duration-normal) var(--ease-out);
  }

  .footer__partner:hover {
    filter: none;
    opacity: 1;
  }

  .footer__partner-logo {
    display: grid;
    place-items: center;
  }

  .footer__partner-logo :global(svg) {
    display: block;
    width: auto;
    height: 20px;
  }

  .footer__grants {
    display: grid;
    place-items: center;
    width: var(--partner-width);
    min-height: var(--partner-height);
    max-width: 100%;
    border-radius: var(--radius-sm);
  }

  .footer__grants:focus-visible,
  .footer__inception-link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 6px;
  }

  .footer__grants-logo {
    width: 100%;
    height: auto;
  }

  .footer__seal {
    display: grid;
    place-items: center;
    width: var(--partner-height);
    height: var(--partner-height);
    border-radius: 50%;
  }

  .footer__seal:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 6px;
  }

  .footer__seal img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* NVIDIA Inception: insignia oficial sin filtros ni cambios de color. */
  .footer__inception {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .footer__inception-badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .footer__inception-link {
    display: block;
    border-radius: var(--radius-sm);
  }

  .footer__inception-link img {
    width: 140px;
    height: auto;
  }

  .footer__ms-partner-link img {
    width: auto;
    height: 40px;
  }

  /* ── Bottom ── */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer__copy {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .footer__origin {
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }

  .footer__origin-logo {
    width: clamp(80px, 8vw, 104px);
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
    -webkit-mask: url("/images/logos/hem-outline-mask.svg") center / contain no-repeat;
    mask: url("/images/logos/hem-outline-mask.svg") center / contain no-repeat;
  }

  :global(:root[data-theme="light"]) .footer__panel {
    background:
      radial-gradient(
        circle at 12% 12%,
        rgba(8, 145, 178, 0.08),
        transparent 40%
      ),
      radial-gradient(
        circle at 90% 92%,
        rgba(37, 99, 235, 0.07),
        transparent 46%
      ),
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.94),
        rgba(245, 248, 253, 0.96)
      );
    box-shadow: 0 12px 36px rgba(15, 23, 42, 0.08);
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .footer__panel {
      padding: var(--space-8) var(--space-6) var(--space-5);
    }

    .footer__top {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .footer__nav {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-8);
    }
  }

  @media (max-width: 640px) {
    .footer {
      padding-top: var(--space-10);
      padding-bottom: var(--space-6);
    }

    .footer__panel {
      padding: var(--space-6) var(--space-4) var(--space-4);
      border-radius: var(--radius-lg);
    }

    .footer__top {
      gap: var(--space-7);
      margin-bottom: var(--space-7);
    }

    .footer__brand {
      align-items: center;
      text-align: center;
      gap: var(--space-3);
    }

    .footer__tagline {
      max-width: 32ch;
      font-size: var(--text-xs);
    }

    .footer__status {
      justify-content: center;
    }

    .footer__socials {
      justify-content: center;
      margin-top: 0;
    }

    .footer__nav {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-3);
    }

    .footer__col {
      gap: var(--space-2);
      padding: var(--space-3);
      border: 1px solid var(--color-border-subtle);
      border-radius: var(--radius-md);
      background: color-mix(in srgb, var(--color-surface-2) 68%, transparent);
    }

    .footer__col:first-child {
      grid-column: 1 / -1;
    }

    .footer__col:first-child .footer__col-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-3);
    }

    .footer__col:first-child .footer__link {
      font-size: var(--text-xs);
      font-weight: var(--weight-semibold);
    }
  }

  @media (max-width: 480px) {
    .footer__nav {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .footer__col {
      gap: var(--space-2);
    }

    .footer__link {
      font-size: var(--text-sm);
    }

    .footer__col:first-child .footer__col-list {
      flex-direction: column;
      gap: var(--space-2);
    }

    .footer__bottom {
      justify-content: center;
      text-align: center;
      padding-top: var(--space-4);
    }

    .footer__copy {
      width: 100%;
    }
  }
</style>
