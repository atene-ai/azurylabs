---
import Button from "../ui/Button.astro";
import Badge from "../ui/Badge.astro";
import BackgroundGlow from "../ui/BackgroundGlow.astro";
import HeroDashboard from "./HeroDashboard.astro";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const conciseSubtext =
  lang === "es"
    ? "Escuadrones de agentes IA para revenue, operación y atención 24/7 con supervisión humana y SLA empresarial."
    : "AI agent squads for revenue, operations, and customer care 24/7 with human supervision and enterprise SLA.";

const quickPoints =
  lang === "es"
    ? ["Tiempo real", "Handoff humano"]
    : [
        "Real-time", "Human handoff",
      ];

const reviews =
  lang === "es"
    ? [
        {
          company: "REALTY OPS",
          quote:
            "Subimos 34% la velocidad de contacto y ventas se enfoca solo en oportunidades listas.",
          metric: "+34% velocidad de contacto",
        },
        {
          company: "HEALTHFLOW",
          quote:
            "Agentes 24/7 con escalación ordenada y consistencia operativa en todos los turnos.",
          metric: "24/7 con SLA",
        },
        {
          company: "NOVA SALES",
          quote:
            "Reactivamos pipeline sin ampliar headcount ni comprometer la experiencia de cliente.",
          metric: "+28% reactivación",
        },
        {
          company: "URBAN CORE",
          quote:
            "En días pasamos de procesos manuales a una célula multiagente conectada al CRM.",
          metric: "Implementación en 7 días",
        },
      ]
    : [
        {
          company: "REALTY OPS",
          quote:
            "We improved contact speed by 34% while sales focuses only on close-ready opportunities.",
          metric: "+34% contact speed",
        },
        {
          company: "HEALTHFLOW",
          quote:
            "24/7 agents with structured escalation and consistent operations across every shift.",
          metric: "24/7 SLA",
        },
        {
          company: "NOVA SALES",
          quote:
            "We reactivated pipeline without increasing headcount or harming customer experience.",
          metric: "+28% reactivation",
        },
        {
          company: "URBAN CORE",
          quote:
            "In days, we moved from manual workflows to a CRM-connected multi-agent cell.",
          metric: "7-day implementation",
        },
      ];
---

<section class="hero" id="inicio">
  <div class="bg-grid" aria-hidden="true"></div>
  <!-- Background glow orbs -->
  <BackgroundGlow
    role="brand"
    size="600px"
    top="-100px"
    right="-100px"
    animation="orb-float 8s ease-in-out infinite"
  />
  <BackgroundGlow
    role="blue"
    size="400px"
    bottom="0"
    left="-80px"
    animation="orb-float 10s ease-in-out infinite reverse"
  />
  <BackgroundGlow
    role="glow"
    size="300px"
    top="40%"
    left="40%"
    animation="orb-float 12s ease-in-out infinite 2s"
  />

  <div class="container hero__inner">
    <div class="hero__copy">
      <div class="reveal reveal-fade">
        <Badge variant="brand" class="hero__eyebrow">{t("hero.eyebrow")}</Badge>
      </div>

      <h1 class="hero__headline reveal reveal-delay-100" set:html={t("hero.headline")} />

      <p class="hero__sub reveal reveal-delay-200">
        {conciseSubtext}
      </p>

      <div class="hero__actions reveal reveal-delay-300">
        <Button variant="primary" size="lg" href="#productos"
          >{t("hero.ctaPrimary")}</Button
        >
        <Button variant="ghost" size="lg" href={t("cta.link")}
          >{t("hero.ctaSecondary")}</Button
        >
      </div>

      <!-- Trust bar -->
      <div class="hero__trust reveal reveal-fade reveal-delay-400">
        <span class="trust__dot"></span>
        <span class="trust__text">{t("hero.trust")}</span>
      </div>

      <div class="hero__quick-points reveal reveal-delay-400">
        {
          quickPoints.map((point) => (
            <div class="hero__quick-item">
              <span class="hero__quick-dot" aria-hidden="true"></span>
              <span>{point}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="hero__visual reveal reveal-delay-200" aria-hidden="true">
      <HeroDashboard lang={lang} />
    </div>
  </div>

  <div class="container hero__social reveal reveal-delay-300">
    <p class="hero__social-label">
      {lang === "es" ? "Equipos que ya operan con azury" : "Teams already operating with azury"}
    </p>
    <div class="hero__marquee" aria-label={lang === "es" ? "Carrusel de reseñas" : "Reviews carousel"}>
      <div class="hero__marquee-track">
        {reviews.concat(reviews).map((review) => (
          <article class="hero__review-card">
            <p class="hero__review-quote">"{review.quote}"</p>
            <div class="hero__review-meta">
              <span class="hero__review-company">{review.company}</span>
              <span class="hero__review-metric">{review.metric}</span>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: block;
    overflow: hidden;
    padding-top: 68px; /* navbar height */
  }

  /* ── Layout ── */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: var(--space-12);
    padding-block: var(--space-16) var(--space-10);
    width: 100%;
    position: relative;
    z-index: 1;
  }

  /* ── Copy ── */
  .hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
    z-index: 1;
    max-width: 680px;
  }

  .hero__eyebrow {
    margin-bottom: var(--space-2);
  }

  .hero__headline {
    font-family: var(--font-brand);
    font-size: clamp(2.1rem, 4.2vw, 4.15rem);
    font-weight: var(--weight-bold);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  :global(.hero__headline--accent) {
    background: linear-gradient(
      135deg,
      var(--color-brand) 0%,
      var(--color-glow) 60%,
      var(--color-blue) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text-muted);
    max-width: 580px;
  }

  .hero__actions {
    display: flex;
    justify-content: flex-start;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  /* ── Trust ── */
  .hero__trust {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .hero__quick-points {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .hero__quick-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-full);
    padding: 7px 12px;
    background: rgba(255, 255, 255, 0.02);
  }

  .hero__quick-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-blue);
    flex-shrink: 0;
  }

  .trust__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow: 0 0 8px var(--color-brand);
    animation: trust-pulse 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes trust-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.6;
      transform: scale(1.3);
    }
  }

  .trust__text {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  /* ── Visual ── */
  .hero__visual {
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1;
    width: 100%;
    margin-top: var(--space-2);
  }

  .hero__social {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .hero__social-label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .hero__marquee {
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
  }

  .hero__marquee-track {
    display: flex;
    gap: var(--space-4);
    width: max-content;
    animation: reviews-scroll 34s linear infinite;
  }

  .hero__marquee:hover .hero__marquee-track {
    animation-play-state: paused;
  }

  .hero__review-card {
    width: min(340px, calc(100vw - 3rem));
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-4);
    background: linear-gradient(165deg, rgba(17, 19, 24, 0.88), rgba(10, 12, 16, 0.9));
    transition: transform var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .hero__review-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
  }

  .hero__review-quote {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    min-height: 4.6em;
    margin-bottom: var(--space-3);
  }

  .hero__review-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .hero__review-company {
    font-family: var(--font-solid);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  .hero__review-metric {
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-brand);
  }

  @keyframes reviews-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-12);
      padding-block: var(--space-12);
    }

    .hero__copy {
      align-items: center;
      text-align: center;
      margin-inline: auto;
    }

    .hero__actions,
    .hero__trust {
      justify-content: center;
    }

    .hero__quick-points {
      max-width: 560px;
      text-align: left;
    }

    .hero__social {
      text-align: center;
      align-items: center;
      margin-top: var(--space-6);
      padding-bottom: var(--space-12);
    }

    .hero__headline {
      font-size: clamp(2rem, 8vw, 3rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__marquee-track {
      animation: none;
    }
  }

  @media (max-width: 480px) {
    .hero__actions {
      flex-direction: column;
      width: 100%;
    }
    .hero__actions > :global(a),
    .hero__actions > :global(button) {
      width: 100%;
    }
  }

  :global(:root[data-theme="light"]) .hero__review-card {
    background: linear-gradient(165deg, rgba(255, 255, 255, 0.95), rgba(237, 241, 248, 0.95));
    border-color: rgba(15, 23, 42, 0.12);
  }

  :global(:root[data-theme="light"]) .hero__review-quote {
    color: var(--color-text-muted);
  }

  :global(:root[data-theme="light"]) .hero__quick-item {
    background: rgba(15, 23, 42, 0.03);
    border-color: rgba(15, 23, 42, 0.1);
    color: var(--color-text);
  }

  :global(:root[data-theme="light"]) .hero__marquee {
    mask-image: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.95) 8%, rgba(0, 0, 0, 0.95) 92%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, rgba(0, 0, 0, 0.95) 8%, rgba(0, 0, 0, 0.95) 92%, transparent);
  }
</style>
