---
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export interface Props {
  transparent?: boolean;
  lang?: string;
  page?: "home" | "about" | string;
}

const { transparent = false, page = "home" } = Astro.props;
const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const themeLabel = lang === "es" ? "Tema" : "Theme";
const languageLabel = lang === "es" ? "Seleccionar idioma" : "Select language";

// Nav links per page
const blogHref = `/${lang}/blog`;

const homeLinks = [
  { label: t("nav.company"), href: `/${lang}/acerca` },
  { label: t("nav.products"), href: `/${lang}/#productos` },
  { label: t("nav.solutions"), href: `/${lang}/#capacidades` },
  { label: t("nav.howItWorks"), href: `/${lang}/#como-funciona` },
  { label: t("nav.blog"), href: blogHref },
];

const aboutLinks = [
  { label: lang === "es" ? "← Inicio" : "← Home", href: `/${lang}/` },
  { label: lang === "es" ? "Nosotros" : "About", href: "#mision" },
  { label: t("nav.team"), href: "#equipo" },
  { label: lang === "es" ? "Productos" : "Products", href: "#ecosistema" },
  { label: t("about.vision.title"), href: "#vision" },
  { label: lang === "es" ? "Contacto" : "Contact", href: "#contacto" },
  { label: t("nav.blog"), href: blogHref },
];

// En el blog los anclas de la home no aplican: se navega a secciones reales.
const blogLinks = [
  { label: lang === "es" ? "← Inicio" : "← Home", href: `/${lang}/` },
  { label: t("nav.company"), href: `/${lang}/acerca` },
  { label: t("nav.blog"), href: blogHref },
];

const navLinks =
  page === "about"
    ? aboutLinks
    : page === "blog"
      ? blogLinks
      : page === "contact"
        ? blogLinks
        : homeLinks;

// Language switcher logic
const nextLang = lang === "es" ? "en" : "es";
const currentPath = Astro.url.pathname;
let nextPath = currentPath;

if (currentPath === "/" || currentPath === "/es/") {
  nextPath = "/en/";
} else if (currentPath === "/en/") {
  nextPath = "/es/";
} else {
  // Replace /es/ with /en/ or vice versa
  const prefix = `/${lang}/`;
  if (currentPath.startsWith(prefix)) {
    nextPath = currentPath.replace(prefix, `/${nextLang}/`);
  } else {
    // Should not happen with proper routing, but fallback
    nextPath = `/${nextLang}${currentPath}`;
  }
}

const esPath = lang === "es" ? currentPath : nextPath;
const enPath = lang === "en" ? currentPath : nextPath;
---

<header
  class:list={["navbar", transparent && "navbar--transparent"]}
  id="navbar"
>
  <div class="navbar__inner container">
    <!-- Logo -->
    <a href={`/${lang}/`} class="navbar__logo" aria-label="Iruz Labs">
      <img
        src="/images/logos/iruzlabs-logotipo-h-white.png"
        alt="Iruz Labs"
        class="logo__mark"
        width="180"
        height="52"
        loading="eager"
      />
    </a>

    <!-- Nav links -->
    <nav class="navbar__nav" aria-label="Navegación principal">
      {
        navLinks.map((link) => (
          <a href={link.href} class="navbar__link">
            {link.label}
          </a>
        ))
      }
    </nav>

    <!-- Language Switcher & Actions -->
    <div class="navbar__actions">
      <button class="theme-toggle" type="button" aria-label={themeLabel}>
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg class="sun-icon" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </svg>
          <svg class="moon-icon" viewBox="0 0 24 24">
            <path d="M20.7 15.1A8.5 8.5 0 0 1 8.9 3.3 8.5 8.5 0 1 0 20.7 15.1Z"></path>
          </svg>
        </span>
      </button>

      <div class="language-picker">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3c2.3 2.5 3.5 5.5 3.5 9s-1.2 6.5-3.5 9c-2.3-2.5-3.5-5.5-3.5-9S9.7 5.5 12 3Z"></path>
        </svg>
        <select onchange="window.location.href=this.value" aria-label={languageLabel}>
          <option value={esPath} selected={lang === "es"}>ES</option>
          <option value={enPath} selected={lang === "en"}>EN</option>
        </select>
      </div>

      <a href={t("cta.link")} class="navbar__cta">{t("nav.scheduleDemo")}</a>
    </div>

    <div class="navbar__compact-utilities">
      <button class="theme-toggle" type="button" aria-label={themeLabel}>
        <span class="theme-toggle__icon" aria-hidden="true">
          <svg class="sun-icon" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"></path>
          </svg>
          <svg class="moon-icon" viewBox="0 0 24 24">
            <path d="M20.7 15.1A8.5 8.5 0 0 1 8.9 3.3 8.5 8.5 0 1 0 20.7 15.1Z"></path>
          </svg>
        </span>
      </button>
    </div>

    <!-- Mobile toggle -->
    <button
      class="navbar__burger"
      id="burger"
      aria-label="Abrir menú"
      aria-expanded="false"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- Mobile menu (Outside header to avoid stacking context issues) -->
<div class="navbar__mobile" id="mobile-menu" aria-hidden="true">
  <nav class="navbar__mobile-nav">
    {
      navLinks.map((link) => (
        <a href={link.href} class="navbar__link">
          {link.label}
        </a>
      ))
    }
  </nav>

  <div class="navbar__mobile-actions">
    <div class="language-picker language-picker--mobile">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M3 12h18M12 3c2.3 2.5 3.5 5.5 3.5 9s-1.2 6.5-3.5 9c-2.3-2.5-3.5-5.5-3.5-9S9.7 5.5 12 3Z"></path>
      </svg>
      <select onchange="window.location.href=this.value" aria-label={languageLabel}>
        <option value={esPath} selected={lang === "es"}>Español</option>
        <option value={enPath} selected={lang === "en"}>English</option>
      </select>
    </div>
    <a href={t("cta.link")} class="navbar__cta">{t("nav.scheduleDemo")}</a>
  </div>
</div>

<script>
  // @ts-nocheck
  const navbar = document.getElementById("navbar");
  const burger = document.getElementById("burger");
  const mobileMenu = document.getElementById("mobile-menu");

  // Scroll effect
  window.addEventListener(
    "scroll",
    () => {
      if (window.scrollY > 20) {
        navbar?.classList.add("navbar--scrolled");
      } else {
        navbar?.classList.remove("navbar--scrolled");
      }
    },
    { passive: true },
  );

  // Mobile toggle
  burger?.addEventListener("click", () => {
    const isOpen = burger.getAttribute("aria-expanded") === "true";
    const newState = !isOpen;

    burger.setAttribute("aria-expanded", String(newState));
    mobileMenu?.classList.toggle("navbar__mobile--open");
    mobileMenu?.setAttribute("aria-hidden", String(!newState));

    // Toggle body scroll lock
    document.body.style.overflow = newState ? "hidden" : "";
  });

  // Close on link click
  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      mobileMenu.classList.remove("navbar__mobile--open");
      burger?.setAttribute("aria-expanded", "false");
      mobileMenu?.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
    });
  });

  /** @type {(theme: string) => void} */
  const applyTheme = (theme) => {
    const normalized = theme === "light" ? "light" : "dark";
    document.documentElement.dataset.theme = normalized;
    localStorage.setItem("iruz-theme", normalized);
  };

  document.querySelectorAll(".theme-toggle").forEach((button) => {
    button.addEventListener("click", () => {
      const currentTheme = document.documentElement.dataset.theme || "dark";
      applyTheme(currentTheme === "dark" ? "light" : "dark");
    });
  });
</script>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: all var(--duration-normal) var(--ease-out);
    border-bottom: 1px solid transparent;
    padding-block: var(--space-4);
  }

  .navbar--scrolled {
    background: rgba(5, 5, 10, 0.7);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom-color: rgba(255, 255, 255, 0.12);
    padding-block: var(--space-2);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.4);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.75rem, 1.4vw, 1.5rem);
    height: 56px; /* Fixed height for content */
    min-width: 0;
  }

  /* ── Logo ── */
  .navbar__logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    flex-shrink: 0;
    z-index: 10;
  }

  .logo__mark {
    height: 42px;
    width: auto;
    object-fit: contain;
    filter: drop-shadow(0 0 14px rgba(0, 200, 255, 0.28));
    transition:
      transform var(--duration-normal) var(--ease-out),
      filter var(--duration-normal) var(--ease-out),
      height var(--duration-normal) var(--ease-out);
  }

  .navbar__logo:hover .logo__mark {
    transform: scale(1.04);
    filter: drop-shadow(0 0 20px rgba(0, 200, 255, 0.5));
  }

  /* Horizontal logotype swaps to dark version on light theme */
  :global(:root[data-theme="light"]) .logo__mark {
    content: url("/images/logos/iruzlabs-logotipo-h-black.png");
    filter: drop-shadow(0 0 12px rgba(8, 145, 178, 0.22));
  }

  /* Compact when navbar shrinks on scroll */
  .navbar--scrolled .logo__mark {
    height: 36px;
  }

  @media (max-width: 480px) {
    .logo__mark {
      height: 40px;
    }
  }

  /* ── Nav ── */
  .navbar__nav {
    display: none;
    align-items: center;
    gap: clamp(0.65rem, 1.15vw, var(--space-5));
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 18px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(8px);
    flex: 1 1 auto;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
  }

  /* The full navigation needs real desktop width. Until then, use the
     complete mobile menu instead of squeezing or clipping controls. */
  @media (min-width: 1180px) {
    .navbar__nav {
      display: flex;
    }
  }

  .navbar__link {
    font-family: var(--font-body);
    font-size: clamp(0.72rem, 0.82vw, var(--text-sm));
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: all var(--duration-fast);
    white-space: nowrap;
    padding-inline: 2px;
  }

  .navbar__link:hover {
    color: var(--color-text);
    text-shadow: 0 0 12px rgba(255, 255, 255, 0.4);
  }

  /* ── Actions ── */
  .navbar__actions {
    display: none;
    align-items: center;
    gap: clamp(0.5rem, 0.8vw, var(--space-3));
    flex-shrink: 0;
  }

  @media (min-width: 1180px) {
    .navbar__actions {
      display: flex;
    }
  }

  /* Compact utilities shared with Sales OS */
  .navbar__compact-utilities {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  @media (min-width: 1180px) {
    .navbar__compact-utilities { display: none; }
  }

  .theme-toggle {
    position: relative;
    display: grid;
    width: 38px;
    height: 38px;
    flex: none;
    place-items: center;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    color: var(--color-text-muted);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.04) inset;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .theme-toggle:hover {
    transform: translateY(-1px);
    border-color: var(--color-border);
    background: var(--color-brand-dim);
    color: var(--color-brand);
  }

  .theme-toggle:focus-visible,
  .language-picker:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .theme-toggle__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
  }

  .theme-toggle__icon svg {
    position: absolute;
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.65;
    transition:
      opacity 0.35s var(--ease-out),
      transform 0.35s var(--ease-out);
  }

  :global(:root[data-theme="light"]) .sun-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  :global(:root[data-theme="light"]) .moon-icon {
    opacity: 0;
    transform: rotate(-45deg) scale(0.55);
  }

  :global(:root[data-theme="dark"]) .sun-icon {
    opacity: 0;
    transform: rotate(45deg) scale(0.55);
  }

  :global(:root[data-theme="dark"]) .moon-icon {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  .language-picker {
    position: relative;
    display: flex;
    height: 38px;
    align-items: center;
    gap: 0.35rem;
    padding-left: 0.7rem;
    overflow: hidden;
    border: 1px solid var(--color-border-subtle);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-surface) 78%, transparent);
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .language-picker::after {
    position: absolute;
    right: 0.65rem;
    width: 5px;
    height: 5px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    content: "";
    pointer-events: none;
    transform: translateY(-2px) rotate(45deg);
  }

  .language-picker:hover {
    transform: translateY(-1px);
    border-color: var(--color-border);
    background: var(--color-brand-dim);
    color: var(--color-brand);
  }

  .language-picker > svg {
    width: 14px;
    height: 14px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.55;
    pointer-events: none;
  }

  .language-picker select {
    width: 48px;
    height: 100%;
    padding: 0 1.1rem 0 0;
    border: 0;
    outline: none;
    appearance: none;
    background: transparent;
    color: currentColor;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .language-picker option {
    background: var(--color-bg);
    color: var(--color-text);
  }

  /* CTAs */
  .navbar__cta-ghost {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-medium);
    color: var(--color-text);
    text-decoration: none;
    padding: 8px 16px;
    transition: opacity var(--duration-fast);
  }

  .navbar__cta-ghost:hover {
    opacity: 0.8;
  }

  .navbar__cta {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: #fff;
    text-decoration: none;
    background: linear-gradient(135deg, var(--color-brand) 0%, #00c8ff 100%);
    padding: 8px 20px;
    border-radius: 99px;
    transition: all var(--duration-fast);
    box-shadow: 0 4px 12px rgba(8, 145, 178, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .navbar__cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(8, 145, 178, 0.4);
    filter: brightness(1.1);
  }

  /* ── Burger ── */
  .navbar__burger {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: var(--space-2);
    cursor: pointer;
    background: none;
    border: none;
    z-index: 20;
  }

  @media (min-width: 1180px) {
    .navbar__burger {
      display: none;
    }
  }

  /* Compact desktop mode: keeps the about navigation balanced without
     letting the logo or segmented controls compete with the links. */
  @media (min-width: 1180px) and (max-width: 1450px) {
    .navbar__inner {
      gap: 10px;
    }

    .logo__mark {
      height: 36px;
    }

    .navbar--scrolled .logo__mark {
      height: 34px;
    }

    .navbar__nav {
      gap: 8px;
      padding: 7px 10px;
    }

    .navbar__link {
      font-size: 11.5px;
    }

    .navbar__actions {
      gap: 6px;
    }

    .navbar__cta {
      padding: 8px 14px;
      font-size: 12px;
    }
  }

  .navbar__burger span {
    display: block;
    width: 24px;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: all var(--duration-fast) var(--ease-out);
  }

  /* Mobile Open State */
  .navbar__burger[aria-expanded="true"] span:nth-child(1) {
    transform: rotate(45deg) translate(5px, 6px);
  }
  .navbar__burger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }
  .navbar__burger[aria-expanded="true"] span:nth-child(3) {
    transform: rotate(-45deg) translate(5px, -6px);
  }

  /* ── Mobile menu ── */
  .navbar__mobile {
    position: fixed;
    inset: 0;
    background: var(--color-bg);
    padding: 100px var(--space-6) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    transform: translateY(-100%);
    transition:
      transform var(--duration-normal) var(--ease-out),
      visibility 0s 0.3s;
    z-index: 900; /* Behind navbar (1000) but above content */
    visibility: hidden;
  }

  .navbar__mobile--open {
    transform: translateY(0);
    visibility: visible;
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .navbar__mobile-nav {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .navbar__mobile .navbar__link {
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border-subtle);
    padding-bottom: var(--space-4);
    text-decoration: none;
  }

  .navbar__mobile-actions {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .language-picker--mobile {
    width: 100%;
    height: 44px;
  }

  .language-picker--mobile select {
    width: 100%;
    flex: 1;
    font-size: var(--text-sm);
  }

  .navbar__mobile .navbar__cta {
    text-align: center;
    padding: 16px;
    font-size: var(--text-lg);
  }

  :global(:root[data-theme="light"]) .navbar--scrolled {
    background: rgba(246, 247, 251, 0.88);
    border-bottom-color: rgba(15, 23, 42, 0.12);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.12);
  }

  :global(:root[data-theme="light"]) .navbar__nav,
  :global(:root[data-theme="light"]) .language-picker,
  :global(:root[data-theme="light"]) .theme-toggle {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(15, 23, 42, 0.12);
  }

  :global(:root[data-theme="light"]) .navbar__mobile {
    background: #f6f7fb;
  }
</style>
