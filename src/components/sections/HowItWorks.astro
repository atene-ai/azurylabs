---
import Badge from '../ui/Badge.astro';
import BackgroundGlow from '../ui/BackgroundGlow.astro';
import { useTranslations } from '../../i18n/utils';

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const mapCopy = lang === "es"
  ? {
      label: "De reto a sistema",
      inputs: "ENTRADAS",
      people: "Personas",
      process: "Procesos",
      data: "Datos",
      core: "Producto + IA + software",
      output: "RESULTADO",
      outcome: "Una operación que vende, funciona y aprende.",
      aria: "Personas, procesos y datos se convierten mediante Azury Labs en una operación que vende, funciona y aprende",
    }
  : {
      label: "From challenge to system",
      inputs: "INPUTS",
      people: "People",
      process: "Processes",
      data: "Data",
      core: "Product + AI + software",
      output: "OUTCOME",
      outcome: "An operation that sells, works and learns.",
      aria: "People, processes and data become an operation that sells, works and learns through Azury Labs",
    };

const stepsData = [
  { key: 'connect', number: '01', color: 'var(--color-brand)' },
  { key: 'configure', number: '02', color: 'var(--color-blue)' },
  { key: 'scale', number: '03', color: 'var(--color-glow)' },
];

const steps = stepsData.map(s => ({
  ...s,
  title: t(`howItWorks.steps.${s.key}.title`),
  desc: t(`howItWorks.steps.${s.key}.desc`),
  detail: t(`howItWorks.steps.${s.key}.detail`),
}));
---

<section class="how" id="como-funciona">
  <BackgroundGlow role="brand" size="1000px" top="0" left="-400px" blur="140px" />
  <div class="bg-grid" aria-hidden="true"></div>
  <div class="container" style="position: relative; z-index: 1;">
    <div class="how__header">
      <Badge variant="subtle">{t('howItWorks.header.badge')}</Badge>
      <h2 class="how__title" set:html={t('howItWorks.header.title')} />
    </div>

    <div class="how__content">
      <div class="how__visual reveal reveal-fade">
        <div class="visual-wrapper">
          <div class="window-header">
            <div><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
            <p>IRUZ / {mapCopy.label}</p>
          </div>
          <div class="work-map" role="img" aria-label={mapCopy.aria}>
            <div class="work-map__inputs">
              <small>{mapCopy.inputs}</small>
              <div><span>{mapCopy.people}</span><span>{mapCopy.process}</span><span>{mapCopy.data}</span></div>
            </div>
            <span class="work-map__line" aria-hidden="true"></span>
            <div class="work-map__core">
              <img src="/images/logos/iruzlabs-isotipo-light.png" alt="" width="512" height="512" loading="lazy" />
              <div><small>IRUZ LABS</small><strong>{mapCopy.core}</strong></div>
            </div>
            <span class="work-map__line" aria-hidden="true"></span>
            <div class="work-map__outcome">
              <small>{mapCopy.output}</small>
              <strong>{mapCopy.outcome}</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- Right side: Steps -->
      <div class="how__steps">
        {steps.map((step, i) => (
          <div class={`step reveal reveal-delay-${(i + 1) * 100}`} style={`--sc: ${step.color};`}>
            {i < steps.length - 1 && (
              <div class="step__connector" aria-hidden="true"></div>
            )}
            <div class="step__number-wrap">
              <span class="step__number">{step.number}</span>
            </div>
            <div class="step__content">
              <h3 class="step__title">{step.title}</h3>
              <p class="step__desc">{step.desc}</p>
              <div class="step__detail">
                <span class="step__detail-text">{step.detail}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    padding-block: var(--space-24);
    position: relative;
  }

  /* ── Header ── */
  .how__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    margin-bottom: var(--space-16);
  }

  .how__title {
    font-family: var(--font-brand);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
  }

  :global(.how__title--accent) {
    background: linear-gradient(135deg, var(--color-glow) 0%, var(--color-brand) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  /* ── Layout ── */
  .how__content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  /* ── Visual ── */
  .how__visual {
    position: relative;
    width: 100%;
  }

  .visual-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: 
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      0 0 40px rgba(8, 145, 178, 0.15);
    background: var(--color-surface);
  }

  .window-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .window-header > div { display: flex; gap: 6px; }
  .window-header p { color: var(--color-text-faint); font-size: 0.64rem; font-weight: var(--weight-semibold); letter-spacing: 0.1em; text-transform: uppercase; }

  .window-header .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-border);
  }

  .window-header .dot:nth-child(1) { background: #ef4444; }
  .window-header .dot:nth-child(2) { background: #f59e0b; }
  .window-header .dot:nth-child(3) { background: #10b981; }

  .work-map {
    display: flex;
    min-height: 480px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem);
    background:
      linear-gradient(var(--color-border-subtle) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border-subtle) 1px, transparent 1px),
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--color-brand) 13%, transparent), transparent 48%);
    background-size: 34px 34px, 34px 34px, auto;
  }

  .work-map__inputs,
  .work-map__outcome {
    width: min(100%, 430px);
  }

  .work-map small {
    display: block;
    margin-bottom: 0.55rem;
    color: var(--color-text-faint);
    font-size: 0.62rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.16em;
  }

  .work-map__inputs > div {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.55rem;
  }

  .work-map__inputs span {
    padding: 0.75rem 0.5rem;
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface-2) 78%, transparent);
    color: var(--color-text-muted);
    font-size: 0.76rem;
    text-align: center;
  }

  .work-map__line {
    width: 1px;
    height: 34px;
    margin: 0.6rem 0;
    background: linear-gradient(var(--color-border), var(--color-brand));
  }

  .work-map__core {
    display: flex;
    width: min(100%, 430px);
    align-items: center;
    gap: 1rem;
    padding: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-brand) 44%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-brand) 12%, var(--color-surface));
    box-shadow: 0 0 34px color-mix(in srgb, var(--color-brand) 12%, transparent);
  }

  .work-map__core img { width: 50px; height: 50px; object-fit: contain; }
  .work-map__core small { margin-bottom: 0.25rem; color: var(--color-brand); }
  .work-map__core strong { color: var(--color-text); font-family: var(--font-brand); font-size: clamp(1rem, 2vw, 1.28rem); }

  .work-map__outcome {
    padding: 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-glow) 38%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-glow) 10%, var(--color-surface));
  }

  .work-map__outcome small { color: var(--color-glow); }
  .work-map__outcome strong { color: var(--color-text); font-family: var(--font-brand); font-size: clamp(1rem, 2vw, 1.3rem); line-height: 1.3; }

  :global(:root[data-theme="light"]) .visual-wrapper {
    box-shadow:
      0 18px 34px rgba(15, 23, 42, 0.14),
      0 0 0 1px rgba(15, 23, 42, 0.08),
      0 0 26px rgba(8, 145, 178, 0.14);
  }

  :global(:root[data-theme="light"]) .work-map { background-color: rgba(248, 250, 252, 0.86); }

  /* ── Steps ── */
  .how__steps {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    position: relative;
  }

  .step {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    text-align: left;
    gap: var(--space-6);
    position: relative;
  }

  /* Connector line between steps */
  .step__connector {
    position: absolute;
    top: 72px;
    left: 35px;
    width: 2px;
    height: calc(100% + var(--space-8) - 72px);
    background: linear-gradient(180deg, var(--sc), var(--color-border));
    z-index: 0;
  }

  /* Number circle */
  .step__number-wrap {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid var(--sc);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 1;
    box-shadow: 0 0 24px color-mix(in srgb, var(--sc) 25%, transparent);
    flex-shrink: 0;
  }

  .step__number {
    font-family: var(--font-brand);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--sc);
    line-height: 1;
  }

  /* Content */
  .step__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .step__title {
    font-family: var(--font-brand);
    font-size: var(--text-2xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
  }

  .step__desc {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-text-muted);
    line-height: var(--leading-relaxed);
    max-width: 320px;
  }

  .step__detail {
    display: inline-flex;
    justify-content: flex-start;
  }

  .step__detail-text {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-wide);
    color: var(--sc);
    background: color-mix(in srgb, var(--sc) 12%, transparent);
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    border: 1px solid color-mix(in srgb, var(--sc) 25%, transparent);
  }

  @media (max-width: 900px) {
    .how__content {
      grid-template-columns: 1fr;
    }
    
    .how__visual {
      order: -1;
      max-width: 480px;
      margin-inline: auto;
    }
    
    .step__connector {
      left: 35px; /* keep it aligned with circle */
    }
  }

  @media (max-width: 480px) {
    .step {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }
    .step__connector { display: none; }
  }
</style>
