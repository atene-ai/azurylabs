---
import Badge from "../ui/Badge.astro";
import ProcessLine from "../ui/ProcessLine.astro";
import { useTranslations } from "../../i18n/utils";
export interface Props { lang: string; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const intro = lang === "es"
  ? "Un proceso claro para conectar la tecnología con tu operación. De la primera conversación a la mejora continua."
  : "A clear process that connects technology to your operation. From the first conversation to continuous improvement.";
const steps = ["connect", "configure", "scale"].map((key, index) => ({
  number: `0${index + 1}`,
  title: String(t(`howItWorks.steps.${key}.title`)),
  desc: String(t(`howItWorks.steps.${key}.desc`)),
}));
const howToJsonLd = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: lang === "es"
    ? "Cómo implementar IA aplicada y software con Azury Labs"
    : "How to implement applied AI and software with Azury Labs",
  description: intro,
  inLanguage: lang === "en" ? "en" : "es-MX",
  step: steps.map((step, index) => ({
    "@type": "HowToStep",
    position: index + 1,
    name: step.title,
    text: step.desc,
  })),
};
---
<section class="how" id="como-funciona" aria-labelledby="process-title">
  <div class="container">
    <header class="how__header reveal">
      <div><Badge variant="subtle">{t("howItWorks.header.badge")}</Badge><h2 id="process-title" class="how__title" set:html={t("howItWorks.header.title")} /></div>
      <p>{intro}</p>
    </header>
    <div class="process reveal"><ProcessLine lang={lang} steps={steps} /></div>
  </div>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(howToJsonLd)} />
</section>
<style>
  .how { padding-block: clamp(4rem, 8vw, 7rem); }
  .how__header { display: grid; grid-template-columns: 1.3fr 0.7fr; align-items: end; gap: 2rem 5rem; margin-bottom: 3rem; }
  .how__title { margin-top: 1.3rem; font-size: clamp(2rem, 3.7vw, 3.5rem); line-height: 1.08; letter-spacing: -0.045em; text-wrap: balance; }
  :global(.how__title--accent) { color: var(--color-glow); }
  .how__header > p { max-width: 40ch; font-size: 1rem; line-height: 1.8; }
  .process { position: relative; isolation: isolate; overflow: hidden; padding: clamp(0.5rem, 2vw, 1.5rem) clamp(0.75rem, 2.5vw, 2rem) clamp(0.75rem, 2vw, 1.5rem); border: 1px solid #8eb7ef30; border-radius: 2rem; background: #0b1428; box-shadow: 0 24px 70px #00000012; }
  .process::before { position: absolute; z-index: -1; inset: 0; content: ""; background: radial-gradient(ellipse at 50% 110%, #2466be38, transparent 65%), radial-gradient(ellipse at 0 0, #00c8ff12, transparent 55%); }
  @media (max-width: 900px) { .how__header { grid-template-columns: 1fr; gap: 1.5rem; }.how__header > p { max-width: 65ch; } }
  @media (max-width: 640px) { .process { border-radius: 1.5rem; padding-inline: 0.5rem; } }
</style>
