---
import Badge from "../ui/Badge.astro";
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const items = t("faq.items") as { q: string; a: string }[];

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: lang === "en" ? "en" : "es-MX",
  mainEntity: items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<section class="faq" id="faq">
  <div class="container faq__inner">
    <header class="faq__header reveal">
      <Badge variant="subtle">{t("faq.badge")}</Badge>
      <h2 class="faq__title" set:html={t("faq.title")} />
    </header>

    <div class="faq__list">
      {
        items.map((item, index) => (
          <details class="faq__item reveal" style={`transition-delay: ${index * 50}ms`}>
            <summary>
              <span>{item.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqJsonLd)} />
</section>

<style>
  .faq {
    position: relative;
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .faq__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--space-8) var(--space-16);
    align-items: start;
  }

  .faq__header {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .faq__title {
    color: var(--color-text);
    font-family: var(--font-brand);
    font-size: clamp(2rem, 3.8vw, 3.4rem);
    font-weight: var(--weight-bold);
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  :global(.faq__title--accent) {
    background: linear-gradient(120deg, var(--color-brand), var(--color-glow));
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-surface) 94%, transparent);
    transition: border-color var(--duration-normal) var(--ease-out);
  }

  .faq__item[open],
  .faq__item:hover {
    border-color: color-mix(in srgb, var(--color-brand) 42%, var(--color-border));
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    color: var(--color-text);
    font-size: var(--text-base);
    font-weight: var(--weight-semibold);
    line-height: 1.4;
    cursor: pointer;
    list-style: none;
  }

  .faq__item summary::-webkit-details-marker { display: none; }

  .faq__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq__icon::before,
  .faq__icon::after {
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: var(--color-brand);
    content: "";
    transition: transform var(--duration-normal) var(--ease-out);
  }

  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }

  .faq__item p {
    padding: 0 var(--space-6) var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  :global(:root[data-theme="light"]) .faq__item {
    background: rgba(255, 255, 255, 0.94);
    border-color: rgba(15, 23, 42, 0.1);
  }

  @media (max-width: 860px) {
    .faq__inner { grid-template-columns: 1fr; }
  }
</style>
