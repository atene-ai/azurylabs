---
import { useTranslations } from "../../i18n/utils";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<form class="contact-form" data-contact-form>
  <div class="contact-form__row">
    <div class="contact-form__field">
      <label for="contact-name">{t("contactPage.nameLabel")}</label>
      <input id="contact-name" name="name" type="text" required maxlength="200" autocomplete="name" />
    </div>
    <div class="contact-form__field">
      <label for="contact-email">{t("contactPage.emailLabel")}</label>
      <input id="contact-email" name="email" type="email" required maxlength="255" autocomplete="email" />
    </div>
  </div>

  <div class="contact-form__field">
    <label for="contact-message">{t("contactPage.messageLabel")}</label>
    <textarea id="contact-message" name="message" rows="5" required maxlength="4000"></textarea>
  </div>

  <div class="contact-form__honeypot" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="contact-form__footer">
    <button type="submit" class="contact-form__submit">{t("contactPage.submit")}</button>
    <p class="contact-form__status" role="status" aria-live="polite"></p>
  </div>
</form>

<script>
  const form = document.querySelector("[data-contact-form]") as HTMLFormElement | null;

  if (form) {
    const submitButton = form.querySelector("button[type='submit']") as HTMLButtonElement;
    const status = form.querySelector("[role='status']") as HTMLElement;
    const baseUrl = import.meta.env.PUBLIC_ATENEAI_SUPPORT_BASE_URL || "";
    const lang = document.documentElement.lang.startsWith("en") ? "en" : "es";
    const messages = {
      es: {
        sending: "Enviando…",
        submit: "Enviar mensaje",
        success: "Gracias. Recibimos tu mensaje y te responderemos pronto.",
        error: "No se pudo enviar el mensaje. Intenta de nuevo en unos minutos.",
      },
      en: {
        sending: "Sending…",
        submit: "Send message",
        success: "Thanks. We received your message and will get back to you soon.",
        error: "Couldn't send the message. Try again in a few minutes.",
      },
    } as const;
    const message = messages[lang];

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!baseUrl) {
        status.textContent = message.error;
        status.dataset.state = "error";
        return;
      }

      const data = new FormData(form);
      const payload = {
        name: String(data.get("name") || ""),
        email: String(data.get("email") || ""),
        message: String(data.get("message") || ""),
        website: String(data.get("website") || ""),
      };

      submitButton.disabled = true;
      submitButton.textContent = message.sending;
      status.textContent = "";
      status.removeAttribute("data-state");

      try {
        const response = await fetch(`${baseUrl}/api/public/v1/contact`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error(`status ${response.status}`);

        status.textContent = message.success;
        status.dataset.state = "success";
        form.reset();
      } catch (error) {
        console.error("Failed to submit contact form", error);
        status.textContent = message.error;
        status.dataset.state = "error";
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = message.submit;
      }
    });
  }
</script>

<style>
  .contact-form {
    display: grid;
    gap: 1.25rem;
  }

  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .contact-form__field {
    display: grid;
    gap: 0.55rem;
  }

  .contact-form__field label {
    color: var(--color-text);
    font-size: 0.88rem;
    font-weight: 700;
  }

  .contact-form__field input,
  .contact-form__field textarea {
    width: 100%;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg) 58%, transparent);
    color: var(--color-text);
    font: inherit;
    font-size: 1rem;
    line-height: 1.5;
    padding: 0.8rem 0.9rem;
    transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
  }

  .contact-form__field textarea { min-height: 8rem; resize: vertical; }

  .contact-form__field input:focus,
  .contact-form__field textarea:focus {
    outline: none;
    border-color: var(--color-brand);
    background: var(--color-surface);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-brand) 14%, transparent);
  }

  .contact-form__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .contact-form__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
    margin-top: 0.2rem;
  }

  .contact-form__submit {
    min-height: 3rem;
    border-radius: 0.8rem;
    background: linear-gradient(135deg, var(--color-brand), var(--color-glow));
    box-shadow: 0 10px 25px color-mix(in srgb, var(--color-brand) 25%, transparent);
    color: #fff;
    font: inherit;
    font-weight: 800;
    padding: 0.75rem 1.25rem;
    transition: filter 160ms ease, transform 160ms ease;
  }

  .contact-form__submit:hover:not(:disabled) { filter: brightness(1.05); transform: translateY(-1px); }
  .contact-form__submit:disabled { cursor: wait; opacity: 0.65; }

  .contact-form__status { flex: 1 1 14rem; min-height: 1.5em; font-size: 0.88rem; }
  .contact-form__status[data-state="success"] { color: var(--color-brand); }
  .contact-form__status[data-state="error"] { color: #e25858; }

  @media (max-width: 540px) {
    .contact-form__row { grid-template-columns: 1fr; }
    .contact-form__footer { align-items: stretch; }
    .contact-form__submit { width: 100%; }
  }
</style>
