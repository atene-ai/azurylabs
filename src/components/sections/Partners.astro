---
// Franja «Respaldados por» al pie del hero, igual que en iruzlabs.com.
// Alianzas e insignias salen de `iruz-labs-footer.ts` (archivo compartido del
// grupo): si cambia un programa, se edita ahí y lo toman hero y footer.
import { footerBadges, footerCopy, footerLang, footerPartners as partners } from "../../lib/iruz-labs-footer";
import NvidiaInceptionBadge from "../ui/NvidiaInceptionBadge.astro";

export interface Props {
  lang: string;
}

const { lang } = Astro.props;
const grants = footerBadges.elevenLabs;
const footerText = footerCopy[footerLang(lang)];

const copy =
  lang === "es"
    ? { label: "Respaldados por", aria: "Programas y alianzas tecnológicas de Azury Labs" }
    : { label: "Backed by", aria: "Azury Labs technology programs and partnerships" };
---

<section class="partners" aria-label={copy.aria}>
  <div class="container partners__inner">
    <p class="partners__label">{copy.label}</p>
    <ul class="partners__list">
      <li class="partners__item">
        <NvidiaInceptionBadge lang={lang} lazy={false} />
      </li>
      <li class="partners__item partners__item--ms">
        <span class="partners__text">
          <strong>{footerText.microsoftProgram}</strong>
          <span>{footerText.microsoftProgramStatus}</span>
        </span>
      </li>
      {
        partners.map(({ icon, name, status }) => (
          <li class="partners__item">
            <span class="partners__logo" set:html={icon} />
            <span class="partners__text">
              <strong>{name}</strong>
              <span>{status}</span>
            </span>
          </li>
        ))
      }
      <li class="partners__item">
        <a
          href={grants.href}
          class="partners__grants"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src={grants.srcDark}
            alt={grants.alt}
            class="partners__grants-logo partners__grants-logo--dark"
            width={grants.width}
            height={grants.height}
            decoding="async"
          />
          <img
            src={grants.srcLight}
            alt={grants.alt}
            class="partners__grants-logo partners__grants-logo--light"
            width={grants.width}
            height={grants.height}
            decoding="async"
          />
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  /* Sticky al borde inferior: se ve en la primera pantalla aunque el hero sea
     más alto que el viewport, y se asienta al final del hero al hacer scroll. */
  .partners {
    position: sticky;
    bottom: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  .partners__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
  }

  .partners__label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .partners__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3) var(--space-4);
  }

  .partners__item {
    display: inline-flex;
    width: 140px;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 40px;
    padding: 0 var(--space-2);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-subtle);
    background: var(--color-surface);
    color: var(--color-text-muted);
    transition:
      transform var(--duration-normal) var(--ease-out),
      border-color var(--duration-normal) var(--ease-out),
      box-shadow var(--duration-normal) var(--ease-out);
  }

  .partners__item--ms {
    width: auto;
    min-width: 140px;
    padding-inline: var(--space-3);
  }

  .partners__item:hover {
    transform: translateY(-2px);
    border-color: var(--color-border);
    box-shadow: var(--shadow-brand);
  }

  .partners__logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--color-text);
  }

  .partners__logo :global(svg) {
    display: block;
    width: auto;
    height: 20px;
  }

  .partners__grants {
    display: grid;
    place-items: center;
    width: 100%;
    min-height: 38px;
    border-radius: var(--radius-full);
  }

  .partners__grants:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
  }

  .partners__grants-logo {
    display: block;
    width: 100%;
    height: auto;
  }

  .partners__grants-logo--light {
    display: none;
  }

  :global(:root[data-theme="light"]) .partners__grants-logo--dark {
    display: none;
  }

  :global(:root[data-theme="light"]) .partners__grants-logo--light {
    display: block;
  }

  .partners__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    white-space: nowrap;
  }

  .partners__text strong {
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .partners__text span {
    font-size: 0.6875rem;
    font-weight: var(--weight-medium);
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .partners__inner {
      flex-direction: row;
      justify-content: space-between;
      /* deja libre el botón flotante del chat */
      padding-right: 5.5rem;
    }
  }

  @media (max-width: 600px) {
    .partners {
      padding-block: var(--space-3);
    }

    .partners__label {
      display: none;
    }

    /* deja libre el botón flotante del chat */
    .partners__inner {
      padding-right: 4.75rem;
    }

    .partners__list {
      gap: var(--space-2);
    }

    /* En celular solo logo y nombre; el estatus completo se ve desde tablet */
    .partners__text span {
      display: none;
    }

  }
</style>
