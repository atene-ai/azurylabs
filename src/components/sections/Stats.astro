---
import { useTranslations } from "../../i18n/utils";
export interface Props { lang: string; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const stats = [
  { key: "conversations", value: lang === "en" ? "AI" : "IA" },
  { key: "responseTime", value: "8" }, { key: "industries", value: "3" }, { key: "uptime", value: "1:1" },
].map((stat) => ({ ...stat, label: t(`stats.${stat.key}.label`), desc: t(`stats.${stat.key}.desc`) }));
---
<section class="stats" id="empresa" aria-label={lang === "es" ? "Azury Labs en perspectiva" : "Azury Labs at a glance"}>
  <div class="container">
    <div class="stats__intro reveal"><span class="stats__eyebrow">AZURY / {lang === "es" ? "EN PERSPECTIVA" : "AT A GLANCE"}</span><p>{lang === "es" ? "Producto. Criterio. Acompañamiento." : "Products. Expertise. Partnership."}</p></div>
    <dl class="stats__grid">{stats.map((stat) => <div class="stat reveal"><dt>{stat.label}</dt><dd class="stat__value">{stat.value}</dd><dd class="stat__desc">{stat.desc}</dd></div>)}</dl>
  </div>
</section>
<style>
  .stats { padding-block: clamp(3rem, 6vw, 5rem); position: relative; }
  .stats__intro { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-bottom: 1.5rem; border-bottom: 1px solid var(--color-border-subtle); }
  .stats__eyebrow { font-size: 0.65rem; color: var(--color-text-muted); font-weight: 600; letter-spacing: 0.15em; }
  .stats__intro p { color: var(--color-text); font-size: 0.85rem; }
  .stats__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding-top: 2.5rem; }
  .stat { position: relative; display: flex; flex-direction: column; min-width: 0; padding: 0.5rem 2rem 0.5rem 0; }
  .stat + .stat { padding-left: 2rem; border-left: 1px solid var(--color-border-subtle); }
  .stat__value { order: -1; color: var(--color-text); font-size: clamp(3rem, 5vw, 4.8rem); line-height: 1; font-weight: 600; letter-spacing: -0.07em; margin-bottom: 1.4rem; }
  .stat:nth-child(2) .stat__value { color: var(--color-glow); }.stat:nth-child(4) .stat__value { color: var(--color-text-muted); }
  .stat dt { font-size: 0.84rem; font-weight: 600; color: var(--color-text); margin-bottom: 0.6rem; }
  .stat__desc { font-size: 0.76rem; line-height: 1.7; color: var(--color-text-muted); max-width: 25ch; }
  @media (max-width: 800px) { .stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 0; }.stat:nth-child(3) { border-left: 0; padding-left: 0; } }
  @media (max-width: 560px) { .stats__intro { align-items: start; flex-direction: column; }.stat { padding-right: 1rem; }.stat + .stat { padding-left: 1rem; }.stat:nth-child(3) { padding-left: 0; }.stat__value { font-size: 3rem; } }
</style>
