---
export interface Props {
  as?: string;
  variant?: string;
  color?: string;
  class?: string;
  style?: string;
}

const {
  as = "p",
  variant = "body",
  color = "default",
  class: className = "",
  style,
} = Astro.props;

const Tag = as;
const classes = ["type", `type--${variant}`, `type--color-${color}`, className]
  .filter(Boolean)
  .join(" ");
---

{
  Tag === "h1" && (
    <h1 class={classes} style={style}>
      <slot />
    </h1>
  )
}
{
  Tag === "h2" && (
    <h2 class={classes} style={style}>
      <slot />
    </h2>
  )
}
{
  Tag === "h3" && (
    <h3 class={classes} style={style}>
      <slot />
    </h3>
  )
}
{
  Tag === "h4" && (
    <h4 class={classes} style={style}>
      <slot />
    </h4>
  )
}
{
  Tag === "h5" && (
    <h5 class={classes} style={style}>
      <slot />
    </h5>
  )
}
{
  Tag === "h6" && (
    <h6 class={classes} style={style}>
      <slot />
    </h6>
  )
}
{
  Tag === "p" && (
    <p class={classes} style={style}>
      <slot />
    </p>
  )
}
{
  Tag === "span" && (
    <span class={classes} style={style}>
      <slot />
    </span>
  )
}
{
  Tag === "label" && (
    <label class={classes} style={style}>
      <slot />
    </label>
  )
}
{
  Tag === "div" && (
    <div class={classes} style={style}>
      <slot />
    </div>
  )
}

<style>
  /* ── Variants ── */
  :global(.type--display) {
    font-family: var(--font-brand);
    font-size: clamp(var(--text-4xl), 6vw, var(--text-7xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  :global(.type--heading-1) {
    font-family: var(--font-brand);
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  :global(.type--heading-2) {
    font-family: var(--font-brand);
    font-size: clamp(var(--text-2xl), 3vw, var(--text-4xl));
    font-weight: var(--weight-bold);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  :global(.type--heading-3) {
    font-family: var(--font-brand);
    font-size: clamp(var(--text-xl), 2.5vw, var(--text-3xl));
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
  }

  :global(.type--subheading) {
    font-family: var(--font-body);
    font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
    font-weight: var(--weight-medium);
    line-height: var(--leading-normal);
  }

  :global(.type--body) {
    font-family: var(--font-body);
    font-size: var(--text-base);
    font-weight: var(--weight-regular);
    line-height: var(--leading-relaxed);
  }

  :global(.type--body-sm) {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    line-height: var(--leading-relaxed);
  }

  :global(.type--caption) {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    line-height: var(--leading-normal);
  }

  :global(.type--label) {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-tight);
  }

  :global(.type--overline) {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    line-height: var(--leading-tight);
  }

  /* ── Colors ── */
  :global(.type--color-default) {
    color: var(--color-text);
  }
  :global(.type--color-muted) {
    color: var(--color-text-muted);
  }
  :global(.type--color-faint) {
    color: var(--color-text-faint);
  }
  :global(.type--color-brand) {
    color: var(--color-brand);
  }
  :global(.type--color-glow) {
    color: var(--color-glow);
  }
  :global(.type--color-blue) {
    color: var(--color-blue);
  }
  :global(.type--color-gradient) {
    background: linear-gradient(
      135deg,
      var(--color-brand) 0%,
      var(--color-glow) 50%,
      var(--color-blue) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
</style>
