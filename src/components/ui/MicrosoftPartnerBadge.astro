---
// Lockup horizontal transparente de Microsoft AI Cloud Partner Program
// (con variantes para tema oscuro y claro, sincronizado desde iruz-labs-footer.ts).
import { footerBadges, footerCopy, footerLang } from "../../lib/iruz-labs-footer";

export interface Props {
  lang: string;
  height?: number;
  lazy?: boolean;
}

const { lang, height = 30, lazy = true } = Astro.props;
const badge = footerBadges.microsoftPartner;
const label = footerCopy[footerLang(lang)].microsoftPartner;
---

<a
  href={badge.href}
  class="ms-partner"
  target="_blank"
  rel="noopener noreferrer"
  title={label}
  style={`--ms-partner-height: ${height}px`}
>
  <img
    src={badge.srcDark}
    alt={badge.alt}
    class="ms-partner__img ms-partner__img--dark"
    width={badge.width}
    height={badge.height}
    loading={lazy ? "lazy" : "eager"}
    decoding="async"
  />
  <img
    src={badge.srcLight}
    alt={badge.alt}
    class="ms-partner__img ms-partner__img--light"
    width={badge.width}
    height={badge.height}
    loading={lazy ? "lazy" : "eager"}
    decoding="async"
  />
</a>

<style>
  .ms-partner {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-sm);
  }

  .ms-partner:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .ms-partner__img {
    display: block;
    width: auto;
    height: var(--ms-partner-height);
  }

  .ms-partner__img--light {
    display: none;
  }

  :global(:root[data-theme="light"]) .ms-partner__img--dark {
    display: none;
  }

  :global(:root[data-theme="light"]) .ms-partner__img--light {
    display: block;
  }
</style>
