---
const SITE_NAME = "Iruz Labs";
const DEFAULT_OG_IMAGE = "/images/og-default.png";
const SAME_AS = [
  "https://www.facebook.com/profile.php?id=61588787630828",
  "https://www.linkedin.com/company/iruzlabs",
  "https://www.instagram.com/iruzlabsmx/",
];

export interface Props {
  title?: string;
  description?: string;
  /** Codigo BCP-47 para el atributo lang del documento. */
  lang?: string;
  /** URL absoluta o relativa; por defecto la URL actual sin query string. */
  canonical?: string;
  /** Imagen para og:image / twitter:image; por defecto el card de marca. */
  image?: string;
  ogType?: "website" | "article";
  noindex?: boolean;
}

const {
  title = "Iruz Labs",
  description = "",
  lang = "es-MX",
  canonical,
  image = DEFAULT_OG_IMAGE,
  ogType = "website",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site);
const ogImageURL = new URL(image, site);
const locale = lang.startsWith("en") ? "en_US" : "es_MX";
const altLocale = locale === "en_US" ? "es_MX" : "en_US";

// Alternates es/en solo aplican a rutas bajo /[lang]/...
const langMatch = Astro.url.pathname.match(/^\/(es|en)(\/.*)?$/);
const hreflangAlternates = langMatch
  ? (() => {
      const rest = langMatch[2] ?? "/";
      const esHref = new URL(`/es${rest}`, site).toString();
      const enHref = new URL(`/en${rest}`, site).toString();
      return [
        { hreflang: "es", href: esHref },
        { hreflang: "en", href: enHref },
        { hreflang: "x-default", href: esHref },
      ];
    })()
  : [];

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${site}#organization`,
      name: SITE_NAME,
      url: site.toString(),
      logo: new URL("/images/logos/iruzlabs-isotipo-light.png", site).toString(),
      description:
        "Iruz Labs builds applied AI and software products: Atenea (AI agents for real-time messaging and voice), Lindex (autonomous software engineering), Sales OS (omnichannel CRM), Mi Negocio (business management), CIEE (surveys and research) and Systems (custom software).",
      areaServed: ["MX", "CO", "US"],
      knowsAbout: [
        "Applied artificial intelligence",
        "AI agents",
        "Autonomous software engineering",
        "Omnichannel CRM",
        "Market research",
        "Custom software development",
      ],
      sameAs: SAME_AS,
    },
    {
      "@type": "WebSite",
      "@id": `${site}#website`,
      name: SITE_NAME,
      url: site.toString(),
      publisher: { "@id": `${site}#organization` },
      inLanguage: ["es-MX", "en"],
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />

    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalURL} />
    {
      hreflangAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content={locale} />
    {langMatch && <meta property="og:locale:alternate" content={altLocale} />}
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon / iconos oficiales -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#070c12" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2f7fb" media="(prefers-color-scheme: light)" />

    <!-- Structured data (Organization + WebSite) -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

    <script is:inline>
      (() => {
        const savedTheme = localStorage.getItem("iruz-theme");
        const normalized = savedTheme === "light" ? "light" : "dark";
        document.documentElement.dataset.theme = normalized;
      })();
    </script>

    <title>{title}</title>

    <!-- Meta adicional por pagina: JSON-LD especifico, etc. -->
    <slot name="head" />
  </head>
  <body class="noise-overlay app-theme">
    <slot />
    <script>
      const observeElements = () => {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
        );

        document.querySelectorAll(".reveal").forEach((el) => {
          observer.observe(el);
        });
      };

      observeElements();
      document.addEventListener("astro:page-load", observeElements);
    </script>
    <!-- Iruz Links: mide las visitas que llegan desde nuestros links/QR (llave publicable, segura de publicar) -->
    <script is:inline src="https://go.iruzlabs.com/t.js" data-key="iruz_pk_890da6448cd4ae3bf4d5e11b482f6d5e90d5275e180d5df3" defer></script>
  </body>
</html>

<style is:global>
  @import "../styles/global.css";
</style>
