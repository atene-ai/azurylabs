---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/sections/Navbar.astro";
import Footer from "../../../components/sections/Footer.astro";
import {
  getArticleBySlug,
  getEnv,
  hasPublishedVersion,
  mediaUrl,
} from "../../../lib/strapi";
import { renderBlocks } from "../../../lib/blocks";

// Obligatorio SSR: el preview resuelve el borrador en cada request.
export const prerender = false;

const { lang: rawLang, slug } = Astro.params;
const lang = rawLang === "en" ? "en" : "es";
const htmlLang = lang === "en" ? "en" : "es-MX";

// La cookie la pone /api/preview tras validar el secreto de Strapi.
const isPreview = Astro.cookies.get("__preview")?.value === "draft";

const strapiBase = getEnv(Astro.locals, "STRAPI_URL").replace(/\/$/, "");
const article = await getArticleBySlug(slug ?? "", {
  locals: Astro.locals,
  lang,
  status: isPreview ? "draft" : "published",
});

if (isPreview) {
  // Sin esto el iframe del admin queda en blanco por la CSP del navegador.
  Astro.response.headers.set(
    "Content-Security-Policy",
    "frame-ancestors 'self' https://cms.iruzlabs.com",
  );
  // Un borrador nunca debe quedar en cache de Cloudflare ni indexarse.
  Astro.response.headers.set("Cache-Control", "no-store");
  Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");
} else {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=0, s-maxage=300, stale-while-revalidate=600",
  );
}

if (!article) {
  Astro.response.status = 404;
}

const copy = {
  es: {
    notFound: "Articulo no encontrado",
    notFoundBody: "Puede que se haya despublicado o que la URL sea incorrecta.",
    back: "← Volver al blog",
    previewUnpublished: "Vista previa — este articulo aun no esta publicado",
    previewOfPublished: "Vista previa — borrador de un articulo ya publicado",
    exitPreview: "Salir de la vista previa",
    readingTime: (m: number) => `${m} min de lectura`,
  },
  en: {
    notFound: "Article not found",
    notFoundBody: "It may have been unpublished, or the URL is incorrect.",
    back: "← Back to blog",
    previewUnpublished: "Preview — this article is not published yet",
    previewOfPublished: "Preview — draft of an already published article",
    exitPreview: "Exit preview",
    readingTime: (m: number) => `${m} min read`,
  },
}[lang];

const pageTitle = article
  ? (article.seo?.metaTitle ?? `${article.title} — Azury Labs`)
  : copy.notFound;
const pageDescription = article
  ? (article.seo?.metaDescription ?? article.excerpt)
  : copy.notFoundBody;

const canonical =
  article?.seo?.canonicalUrl ??
  new URL(`/${lang}/blog/${slug}`, Astro.site ?? Astro.url).toString();

const ogImage = article
  ? mediaUrl(strapiBase, article.seo?.ogImage?.url ?? article.cover?.url)
  : "";

const site = Astro.site ?? Astro.url;
const blogIndexHref = new URL(`/${lang}/blog`, site).toString();

const blogPostingJsonLd = article && {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: article.title,
  description: article.excerpt,
  ...(ogImage && { image: [ogImage] }),
  ...(article.publishedAt && { datePublished: article.publishedAt }),
  dateModified: article.updatedAt,
  ...(article.author?.name && {
    author: { "@type": "Person", name: article.author.name },
  }),
  publisher: {
    "@type": "Organization",
    name: "Azury Labs",
    logo: {
      "@type": "ImageObject",
      url: new URL("/images/logos/azurylabs-isotipo-light.png", site).toString(),
    },
  },
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
};

const breadcrumbJsonLd = article && {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Azury Labs", item: site.toString() },
    { "@type": "ListItem", position: 2, name: "Blog", item: blogIndexHref },
    { "@type": "ListItem", position: 3, name: article.title, item: canonical },
  ],
};

const publishedLabel =
  article?.publishedAt &&
  new Intl.DateTimeFormat(htmlLang, {
    day: "numeric",
    month: "long",
    year: "numeric",
  }).format(new Date(article.publishedAt));

const body = article ? renderBlocks(article.content, strapiBase) : "";
const exitHref = `/api/preview/exit?url=${encodeURIComponent(`/${lang}/blog/${slug}`)}`;

// La cookie de preview vive una hora, asi que sobrevive a que publiques.
// Anunciar "sin publicar" en ese caso es falso, y `article.publishedAt` no
// sirve para distinguirlo porque en la entrada borrador siempre es null.
const isLive =
  isPreview && article
    ? await hasPublishedVersion(slug ?? "", { locals: Astro.locals, lang })
    : false;

const previewLabel = isLive
  ? copy.previewOfPublished
  : copy.previewUnpublished;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang={htmlLang}
  canonical={canonical}
  image={ogImage || undefined}
  ogType={article ? "article" : "website"}
  noindex={isPreview || article?.seo?.noIndex || false}
>
  <Fragment slot="head">
    {blogPostingJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(blogPostingJsonLd)} />
    )}
    {breadcrumbJsonLd && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)} />
    )}
  </Fragment>

  <Navbar lang={lang} page="blog" />

  {
    isPreview && (
      <div class="preview-bar">
        <span>{previewLabel}</span>
        <a href={exitHref}>{copy.exitPreview}</a>
      </div>
    )
  }

  <main class:list={["article", isPreview && "article--preview"]}>
    {
      !article ? (
        <div class="article-missing">
          <h1>{copy.notFound}</h1>
          <p>{copy.notFoundBody}</p>
          <a href={`/${lang}/blog`}>{copy.back}</a>
        </div>
      ) : (
        <>
          <header class="article-header">
            {article.categories && article.categories.length > 0 && (
              <span class="article-cats">
                {article.categories.map((c) => c.name).join(" · ")}
              </span>
            )}
            <h1>{article.title}</h1>
            <p class="article-excerpt">{article.excerpt}</p>
            <div class="article-meta">
              {article.author?.name && <span>{article.author.name}</span>}
              {publishedLabel && <span>{publishedLabel}</span>}
              {article.readingTime && (
                <span>{copy.readingTime(article.readingTime)}</span>
              )}
            </div>
          </header>

          {article.cover?.url && (
            <img
              class="article-cover"
              src={mediaUrl(strapiBase, article.cover.url)}
              alt={article.cover.alternativeText ?? ""}
              decoding="async"
            />
          )}

          <div class="article-body" set:html={body} />

          <a class="article-back" href={`/${lang}/blog`}>
            {copy.back}
          </a>
        </>
      )
    }
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  /* Va abajo y no arriba: el navbar del sitio es fixed con z-index 1000,
     asi que cualquier barra pegada al top queda tapada por el. */
  .preview-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 1100;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    padding: var(--space-3) var(--space-4);
    background: #b45309;
    color: #fff;
    font-size: var(--text-sm);
    box-shadow: 0 -4px 16px rgb(0 0 0 / 0.25);
  }

  .preview-bar a {
    color: #fff;
    text-decoration: underline;
  }

  .article {
    max-width: 46rem;
    margin: 0 auto;
    padding: 6rem 1.5rem 5rem;
  }

  /* Deja aire al final para que la barra fija no cubra el ultimo parrafo.
     Va despues de .article a proposito: misma especificidad, y el shorthand
     `padding` de arriba pisaria este padding-bottom si fuera al reves. */
  .article--preview {
    padding-bottom: var(--space-24);
  }

  .article-header {
    margin-bottom: 2.5rem;
  }

  .article-cats {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    opacity: 0.6;
  }

  .article-header h1 {
    font-size: clamp(1.875rem, 5vw, 2.75rem);
    line-height: 1.15;
    margin: 0.5rem 0 1rem;
  }

  .article-excerpt {
    font-size: 1.125rem;
    opacity: 0.8;
  }

  .article-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    opacity: 0.6;
    margin-top: 1.25rem;
  }

  .article-cover {
    width: 100%;
    border-radius: 0.875rem;
    margin-bottom: 2.5rem;
  }

  .article-body {
    line-height: 1.75;
  }

  .article-body :global(h2) {
    font-size: 1.5rem;
    margin: 2.5rem 0 0.75rem;
  }

  .article-body :global(h3) {
    font-size: 1.25rem;
    margin: 2rem 0 0.5rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.375rem;
  }

  .article-body :global(blockquote) {
    border-left: 3px solid color-mix(in srgb, currentColor 30%, transparent);
    padding-left: 1rem;
    margin: 0 0 1.25rem;
    opacity: 0.85;
    font-style: italic;
  }

  .article-body :global(pre) {
    background: color-mix(in srgb, currentColor 8%, transparent);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1.25rem;
  }

  .article-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  .article-body :global(figure) {
    margin: 0 0 1.5rem;
  }

  /* Hashtag suelto en medio de un parrafo: solo color, sin romper la linea. */
  .article-body :global(.hashtag) {
    color: var(--color-brand);
    text-decoration: none;
    font-weight: var(--weight-medium);
  }

  .article-body :global(.hashtag:hover) {
    text-decoration: underline;
  }

  /* Fila de etiquetas al cierre del articulo: ahi si van como chips. */
  .article-body :global(.hashtags) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
    margin: var(--space-10) 0 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border-subtle);
    font-size: var(--text-sm);
    color: var(--color-text-faint);
  }

  .article-body :global(.hashtags .hashtag) {
    display: inline-flex;
    align-items: center;
    padding: 2px var(--space-3);
    border: 1px solid color-mix(in srgb, var(--color-brand) 24%, transparent);
    border-radius: var(--radius-full);
    background: color-mix(in srgb, var(--color-brand) 10%, transparent);
    transition: background 0.15s ease;
  }

  .article-body :global(.hashtags .hashtag:hover) {
    background: color-mix(in srgb, var(--color-brand) 20%, transparent);
    text-decoration: none;
  }

  .article-back {
    display: inline-block;
    margin-top: 3rem;
    opacity: 0.75;
  }

  .article-missing {
    text-align: center;
    padding: 4rem 0;
  }
</style>
