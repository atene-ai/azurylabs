---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navbar from "../../../components/sections/Navbar.astro";
import Footer from "../../../components/sections/Footer.astro";
import Tag from "../../../components/ui/Tag.astro";
import { getArticles, getEnv, mediaUrl } from "../../../lib/strapi";

export const prerender = false;

const { lang: rawLang } = Astro.params;
const lang = rawLang === "en" ? "en" : "es";
const htmlLang = lang === "en" ? "en" : "es-MX";

const strapiBase = getEnv(Astro.locals, "STRAPI_URL").replace(/\/$/, "");
const articles = await getArticles({ locals: Astro.locals, lang });
const [featured, ...rest] = articles;

const copy = {
  es: {
    title: "Blog — Iruz Labs",
    eyebrow: "IRUZ / PERSPECTIVAS",
    heading: "Ideas para operar mejor.",
    intro: "Notas sobre inteligencia aplicada, productos, automatización y las decisiones que convierten tecnología en avance.",
    latest: "LO MÁS RECIENTE",
    empty: "Todavía no hay artículos publicados.",
    readingTime: (minutes: number) => `${minutes} min de lectura`,
    readMore: "Leer artículo",
  },
  en: {
    title: "Blog — Iruz Labs",
    eyebrow: "IRUZ / PERSPECTIVES",
    heading: "Ideas for better operations.",
    intro: "Notes on applied intelligence, products, automation and the decisions that turn technology into progress.",
    latest: "LATEST",
    empty: "There are no published articles yet.",
    readingTime: (minutes: number) => `${minutes} min read`,
    readMore: "Read article",
  },
}[lang];

const fmtDate = (iso: string | null) => iso
  ? new Intl.DateTimeFormat(htmlLang, { day: "numeric", month: "long", year: "numeric" }).format(new Date(iso))
  : "";

Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=300, stale-while-revalidate=600");
---

<BaseLayout title={copy.title} description={copy.intro} lang={htmlLang}>
  <Navbar lang={lang} page="blog" />

  <main class="blog">
    <div class="bg-grid" aria-hidden="true"></div>
    <header class="container blog__header">
      <p class="blog__eyebrow"><span aria-hidden="true"></span>{copy.eyebrow}</p>
      <div class="blog__heading-row">
        <h1>{copy.heading}</h1>
        <p>{copy.intro}</p>
      </div>
      <div class="blog__status">
        <span>{copy.latest}</span>
        <b>{String(articles.length).padStart(2, "0")}</b>
      </div>
    </header>

    <div class="container blog__content">
      {!featured && <p class="blog__empty">{copy.empty}</p>}

      {featured && (
        <a class="featured" href={`/${lang}/blog/${featured.slug}`}>
          <div class="featured__body">
            <div class="featured__topline">
              {featured.categories?.[0] && <Tag color="brand">{featured.categories[0].name}</Tag>}
              <span>{copy.latest}</span>
            </div>
            <h2>{featured.title}</h2>
            <p class="featured__excerpt">{featured.excerpt}</p>
            <div class="meta">
              {featured.author?.name && <span>{featured.author.name}</span>}
              {featured.publishedAt && <span>{fmtDate(featured.publishedAt)}</span>}
              {featured.readingTime && <span>{copy.readingTime(featured.readingTime)}</span>}
            </div>
            <span class="featured__cta">{copy.readMore} <b aria-hidden="true">→</b></span>
          </div>

          <div class:list={["featured__media", !featured.cover?.url && "featured__media--placeholder"]}>
            {featured.cover?.url ? (
              <img src={mediaUrl(strapiBase, featured.cover.url)} alt={featured.cover.alternativeText ?? ""} loading="eager" decoding="async" />
            ) : (
              <span aria-hidden="true">IRUZ / 01</span>
            )}
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <ul class="mosaic">
          {rest.map((article, index) => (
            <li>
              <a class="card" href={`/${lang}/blog/${article.slug}`}>
                <div class:list={["card__media", !article.cover?.url && "card__media--placeholder"]}>
                  {article.cover?.url ? (
                    <img src={mediaUrl(strapiBase, article.cover.url)} alt={article.cover.alternativeText ?? ""} loading="lazy" decoding="async" />
                  ) : <span aria-hidden="true">IRUZ / {String(index + 2).padStart(2, "0")}</span>}
                  {article.categories?.[0] && <span class="card__tag"><Tag color="brand">{article.categories[0].name}</Tag></span>}
                </div>
                <div class="card__body">
                  <h3>{article.title}</h3>
                  <p>{article.excerpt}</p>
                  <div class="meta">
                    {article.publishedAt && <span>{fmtDate(article.publishedAt)}</span>}
                    {article.readingTime && <span>{copy.readingTime(article.readingTime)}</span>}
                  </div>
                  <span class="card__cta">{copy.readMore} <b aria-hidden="true">→</b></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .blog {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    padding: 80px 0 var(--space-24);
  }

  .blog::before {
    position: absolute;
    top: -20rem;
    left: 48%;
    width: 46rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-brand) 17%, transparent), transparent 68%);
    content: "";
    filter: blur(12px);
    pointer-events: none;
  }

  .blog__header,
  .blog__content { position: relative; z-index: 1; }

  .blog__header { padding-top: clamp(4.2rem, 9vw, 8rem); }

  .blog__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.15em;
  }

  .blog__eyebrow span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-brand);
    box-shadow: 0 0 14px var(--color-brand);
  }

  .blog__heading-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.48fr);
    align-items: end;
    gap: 2rem;
    margin-top: 1rem;
  }

  .blog__heading-row h1 {
    max-width: 18ch;
    font-size: clamp(var(--text-4xl), 4vw, var(--text-5xl));
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .blog__heading-row p { max-width: 43ch; font-size: clamp(1rem, 1.25vw, 1.14rem); }

  .blog__status {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(2.2rem, 5vw, 4.6rem);
    border-block: 1px solid var(--color-border-subtle);
    color: var(--color-text-faint);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.13em;
    padding-block: 0.8rem;
  }

  .blog__status b { color: var(--color-brand); font-size: 0.88rem; }
  .blog__content { padding-top: clamp(2rem, 5vw, 4.5rem); }
  .blog__empty { color: var(--color-text-muted); }

  .featured {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(18rem, 0.84fr);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    background: var(--color-surface);
    color: inherit;
    text-decoration: none;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .featured:hover { border-color: var(--color-brand); box-shadow: var(--shadow-lg); transform: translateY(-3px); }

  .featured__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
    min-height: 30rem;
    padding: clamp(1.8rem, 4vw, 4.25rem);
  }

  .featured__topline { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 1rem; }
  .featured__topline > span { color: var(--color-text-faint); font-size: 0.66rem; font-weight: 800; letter-spacing: 0.12em; }
  .featured__body h2 { max-width: 20ch; font-size: clamp(var(--text-2xl), 2.8vw, var(--text-4xl)); line-height: 1.08; letter-spacing: -0.03em; }
  .featured__excerpt { max-width: 48ch; font-size: 1.05rem; }

  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; color: var(--color-text-faint); font-size: 0.8rem; }
  .meta span + span::before { color: var(--color-brand); content: "•"; margin-right: 1rem; }
  .featured__cta, .card__cta { margin-top: auto; color: var(--color-brand); font-size: 0.9rem; font-weight: 780; }
  .featured__cta b, .card__cta b { display: inline-block; transition: transform 180ms ease; }
  .featured:hover .featured__cta b, .card:hover .card__cta b { transform: translateX(4px); }

  .featured__media, .card__media {
    position: relative;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .featured__media img, .card__media img { width: 100%; height: 100%; object-fit: cover; transition: transform 500ms var(--ease-out); }
  .featured:hover .featured__media img, .card:hover .card__media img { transform: scale(1.04); }
  .featured__media--placeholder, .card__media--placeholder {
    display: grid;
    place-items: center;
    background: radial-gradient(circle at 70% 20%, color-mix(in srgb, var(--color-brand) 25%, transparent), transparent 42%), var(--color-surface-2);
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .mosaic { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; margin-top: 1.25rem; }
  .card { display: flex; flex-direction: column; height: 100%; overflow: hidden; border: 1px solid var(--color-border-subtle); border-radius: 1.15rem; background: var(--color-surface); color: inherit; text-decoration: none; transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .card:hover { border-color: var(--color-brand); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .card__media { aspect-ratio: 1.45 / 1; }
  .card__tag { position: absolute; top: 1rem; left: 1rem; }
  .card__body { display: flex; flex: 1; flex-direction: column; gap: 0.85rem; padding: 1.35rem; }
  .card__body h3 { font-size: 1.3rem; line-height: 1.12; }
  .card__body > p { font-size: 0.94rem; }

  @media (max-width: 820px) {
    .blog__heading-row, .featured { grid-template-columns: 1fr; }
    .blog__heading-row h1 { max-width: 11ch; }
    .featured__media { min-height: 18rem; order: -1; }
    .featured__body { min-height: auto; }
    .mosaic { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 540px) {
    .blog { padding-bottom: var(--space-14); }
    .blog__header { padding-top: 3.5rem; }
    .blog__heading-row h1 { font-size: clamp(2.3rem, 11vw, var(--text-5xl)); }
    .featured { border-radius: 1rem; }
    .featured__body { padding: 1.4rem; }
    .featured__media { min-height: 14rem; }
    .mosaic { grid-template-columns: 1fr; }
  }
</style>
