---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import { useTranslations } from "../../i18n/utils";
import { getEnv, getTeamMembers, mediaUrl } from "../../lib/strapi";
import SocialIcon from "../../components/ui/SocialIcon.astro";
import ContactForm from "../../components/sections/ContactForm.astro";

// SSR para que un integrante recien agregado en Strapi aparezca sin rebuild.
export const prerender = false;

const { lang: rawLang } = Astro.params;
const lang = rawLang === "en" ? "en" : "es";
const htmlLang = lang === "en" ? "en" : "es-MX";
const t = useTranslations(lang);
const contactCopy = lang === "es"
  ? {
      eyebrow: "CONSTRUYAMOS EL SIGUIENTE SISTEMA",
      title: "¿Qué necesita tu operación para avanzar?",
      text: "Cuéntanos el reto. Diseñamos el siguiente paso con producto, inteligencia, datos o desarrollo a medida.",
    }
  : {
      eyebrow: "LET'S BUILD THE NEXT SYSTEM",
      title: "What does your operation need to move forward?",
      text: "Tell us the challenge. We will design the next step with product, intelligence, data or custom development.",
    };

const titleMap = {
  es: "Acerca de Iruz Labs — Inteligencia artificial aplicada",
  en: "About Iruz Labs — Applied artificial intelligence",
};

const strapiBase = getEnv(Astro.locals, "STRAPI_URL").replace(/\/$/, "");
const teamMembers = await getTeamMembers({ locals: Astro.locals, lang });

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=600",
);
---

<BaseLayout
  title={titleMap[lang as keyof typeof titleMap]}
  description={t("about.hero.subtitle")}
  lang={htmlLang}
>
  <Navbar lang={lang} page="about" />

  <main class="about-page">
    <section id="mision" class="about-hero">
      <div class="container about-hero__inner">
        <div class="about-hero__copy">
          <p class="about-hero__eyebrow"><span aria-hidden="true"></span>{t("nav.company")}</p>
          <h1 class="about-hero__title">{t("about.hero.title")}</h1>
          <p class="about-hero__subtitle">{t("about.hero.subtitle")}</p>
          <a class="about-hero__contact-link" href="#contacto">
            {lang === "es" ? "Hablemos de tu operación" : "Let's talk about your operation"} <span aria-hidden="true">↓</span>
          </a>
        </div>
        <aside class="about-hero__statement" aria-label={lang === "es" ? "Tesis Iruz" : "Iruz thesis"}>
          <span class="about-hero__statement-index">IRUZ / 2026</span>
          <blockquote>{t("about.hero.quote")}</blockquote>
          <div class="about-hero__statement-lines" aria-hidden="true">
            <span>PRODUCTO</span><span>IA</span><span>DATOS</span><span>SOFTWARE</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- Team Section -->
    {
      teamMembers.length > 0 && (
        <section id="equipo" class="about-team">
          <div class="container about-team__inner">
            <span class="badge">{t("about.team.badge")}</span>
            <h2 class="section-title">{t("about.team.title")}</h2>
            <p class="about-team__subtitle">{t("about.team.subtitle")}</p>

            <div class="team-grid">
              {teamMembers.map((member) => (
                <div class="team-card">
                  <a href={`/${lang}/equipo/${member.slug}`} class="team-card__link">
                    {member.avatar?.url && (
                      <img
                        class="team-card__photo"
                        src={mediaUrl(strapiBase, member.avatar.url)}
                        alt={member.avatar.alternativeText || member.name}
                        width="120"
                        height="120"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    <h3 class="team-card__name">{member.name}</h3>
                    <p class="team-card__role">{member.role}</p>
                    <p class="team-card__bio">{member.bio}</p>
                  </a>
                  {member.socials && member.socials.length > 0 && (
                    <div class="team-card__socials">
                      {member.socials.map((social) => (
                        <a
                          href={social.url}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="team-card__social"
                          aria-label={social.platform}
                        >
                          <SocialIcon platform={social.platform} />
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Ecosystem Section -->
    <section id="ecosistema" class="about-ecosystem">
      <div class="container about-ecosystem__inner">
        <span class="badge">{t("about.ecosystem.badge")}</span>
        <h2 class="section-title">{t("about.ecosystem.title")}</h2>
        <p class="about-ecosystem__subtitle">{t("about.ecosystem.subtitle")}</p>

        <div class="ecosystem-grid">
          <div class="ecosystem-card">
            <img
              src="/images/logos/iruzlabs-atenea-logo.png"
              alt="Iruz Atenea"
              class="ecosystem-card__logo"
              loading="lazy"
            />
            <h3>{t("about.ecosystem.items.atenea.name")}</h3>
            <p>{t("about.ecosystem.items.atenea.desc")}</p>
            <a href="https://v3.atenea.iruzlabs.com" target="_blank" rel="noopener noreferrer" class="ecosystem-card__link">
              {t("about.ecosystem.cta")} →
            </a>
          </div>
          <div class="ecosystem-card">
            <img
              src="/images/logos/lindex-logo.png"
              alt="Lindex by Iruz Labs"
              class="ecosystem-card__logo ecosystem-card__logo--lindex"
              loading="lazy"
            />
            <h3>{t("about.ecosystem.items.lindex.name")}</h3>
            <p>{t("about.ecosystem.items.lindex.desc")}</p>
            <a href="https://lindex.iruzlabs.com" target="_blank" rel="noopener noreferrer" class="ecosystem-card__link">
              {t("about.ecosystem.cta")} →
            </a>
          </div>
          <div class="ecosystem-card">
            <span class="ecosystem-card__wordmark gradient-text">SALES OS</span>
            <h3>{t("about.ecosystem.items.crm.name")}</h3>
            <p>{t("about.ecosystem.items.crm.desc")}</p>
            <a href="https://crm.iruzlabs.com" target="_blank" rel="noopener noreferrer" class="ecosystem-card__link">
              {t("about.ecosystem.cta")} →
            </a>
          </div>
          <div class="ecosystem-card ecosystem-card--minegocio">
            <span class="ecosystem-card__wordmark ecosystem-card__wordmark--minegocio">
              <small>IRUZ</small>
              <strong>Mi Negocio</strong>
            </span>
            <h3>{t("about.ecosystem.items.minegocio.name")}</h3>
            <p>{t("about.ecosystem.items.minegocio.desc")}</p>
            <a href={`https://minegocio.iruzlabs.com/${lang}`} target="_blank" rel="noopener noreferrer" class="ecosystem-card__link">
              {t("about.ecosystem.cta")} →
            </a>
          </div>
          <div class="ecosystem-card">
            <img
              src="/images/logos/iruzlabs-ciee-logo.png"
              alt="Iruz CIEE"
              class="ecosystem-card__logo"
              loading="lazy"
            />
            <h3>{t("about.ecosystem.items.ciee.name")}</h3>
            <p>{t("about.ecosystem.items.ciee.desc")}</p>
            <a href="https://ciee.iruzlabs.com" target="_blank" rel="noopener noreferrer" class="ecosystem-card__link">
              {t("about.ecosystem.cta")} →
            </a>
          </div>
          <div class="ecosystem-card">
            <span class="ecosystem-card__wordmark gradient-text">SYSTEMS</span>
            <h3>{t("about.ecosystem.items.systems.name")}</h3>
            <p>{t("about.ecosystem.items.systems.desc")}</p>
            <a href="https://systems.iruzlabs.com" target="_blank" rel="noopener noreferrer" class="ecosystem-card__link">
              {t("about.ecosystem.cta")} →
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision Section -->
    <section id="vision" class="about-vision">
      <div class="container about-vision__inner">
        <h2 class="section-title">{t("about.vision.title")}</h2>
        <p class="vision-text">{t("about.vision.text")}</p>
      </div>
    </section>

    <!-- Values Section -->
    <section id="valores" class="about-values">
      <div class="container">
        <h2 class="section-title">{t("about.values.title")}</h2>
        <div class="values-grid">
          <!-- Value 1 -->
          <div class="value-card">
            <div class="value-icon">⚡️</div>
            <h3>{t("about.values.v1.title")}</h3>
            <p>{t("about.values.v1.desc")}</p>
          </div>
          <!-- Value 2 -->
          <div class="value-card">
            <div class="value-icon">🧹</div>
            <h3>{t("about.values.v2.title")}</h3>
            <p>{t("about.values.v2.desc")}</p>
          </div>
          <!-- Value 3 -->
          <div class="value-card">
            <div class="value-icon">🌐</div>
            <h3>{t("about.values.v3.title")}</h3>
            <p>{t("about.values.v3.desc")}</p>
          </div>
          <!-- Value 4 -->
          <div class="value-card">
            <div class="value-icon">🏆</div>
            <h3>{t("about.values.v4.title")}</h3>
            <p>{t("about.values.v4.desc")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Brand Personality Section -->
    <section id="personalidad" class="about-personality">
      <div class="container">
        <h2 class="section-title">{t("about.personality.title")}</h2>
        <div class="personality-grid">
          <div class="personality-card">
            <h3>{t("about.personality.items.p1.title")}</h3>
            <p>{t("about.personality.items.p1.desc")}</p>
          </div>
          <div class="personality-card">
            <h3>{t("about.personality.items.p2.title")}</h3>
            <p>{t("about.personality.items.p2.desc")}</p>
          </div>
          <div class="personality-card">
            <h3>{t("about.personality.items.p3.title")}</h3>
            <p>{t("about.personality.items.p3.desc")}</p>
          </div>
        </div>
        <p class="brand-slogan">{t("about.personality.slogan")}</p>
      </div>
    </section>

    <!-- Tone & Voice -->
    <section class="about-tone">
      <div class="container about-tone__inner">
        <h2 class="section-title">{t("about.tone.title")}</h2>
        <p class="tone-text">{t("about.tone.desc")}</p>
      </div>
    </section>

    <section id="contacto" class="about-contact">
      <div class="container about-contact__inner">
        <div class="about-contact__copy">
          <p class="about-contact__eyebrow"><span aria-hidden="true"></span>{contactCopy.eyebrow}</p>
          <h2>{contactCopy.title}</h2>
          <p>{contactCopy.text}</p>
          <a href={`/${lang}/contacto`} class="about-contact__route">
            {lang === "es" ? "Abrir página de contacto" : "Open contact page"} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="about-contact__form">
          <ContactForm lang={lang} />
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .about-page {
    padding-top: 80px;
    background: var(--color-bg);
  }

  .section-title {
    font-size: var(--text-3xl);
    text-align: center;
    margin-bottom: var(--space-8);
    color: var(--color-text);
  }

  /* Hero */
  .about-hero {
    padding: var(--space-20) 0;
    text-align: center;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(8, 145, 178, 0.15),
      transparent 70%
    );
  }

  .about-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
  }

  .badge {
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(8, 145, 178, 0.1);
    padding: 6px 12px;
    border-radius: 99px;
    border: 1px solid rgba(8, 145, 178, 0.2);
  }

  .about-hero__title {
    font-size: var(--text-5xl);
    line-height: 1.1;
    color: var(--color-text);
  }

  .about-hero__subtitle {
    font-size: var(--text-xl);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .about-hero__quote {
    font-size: var(--text-2xl);
    font-style: italic;
    color: var(--color-text);
    margin-top: var(--space-8);
    border-left: 4px solid var(--color-brand);
    padding-left: var(--space-6);
  }

  /* Team / Founder */
  .about-team {
    padding: var(--space-20) 0;
  }

  .about-team__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 800px;
    margin: 0 auto;
    gap: var(--space-4);
  }

  .about-team__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    max-width: 640px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: var(--space-6);
    width: 100%;
  }

  .team-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: transform var(--duration-normal), border-color var(--duration-normal);
  }

  .team-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-brand);
  }

  .team-card__link {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }

  .team-card__photo {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-full);
    object-fit: cover;
    border: 2px solid var(--color-brand);
    margin-bottom: var(--space-4);
  }

  .team-card__name {
    font-size: var(--text-lg);
    color: var(--color-text);
    font-weight: var(--weight-bold);
  }

  .team-card__role {
    color: var(--color-brand);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-3);
  }

  .team-card__bio {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }

  .team-card__socials {
    display: flex;
    gap: var(--space-2);
  }

  .team-card__social {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    transition:
      border-color var(--duration-fast),
      color var(--duration-fast),
      transform var(--duration-fast);
  }

  .team-card__social:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
    transform: translateY(-2px);
  }

  /* Ecosystem */
  .about-ecosystem {
    padding: var(--space-20) 0;
    background: rgba(255, 255, 255, 0.02);
    border-block: 1px solid var(--color-border);
  }

  .about-ecosystem__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    gap: var(--space-4);
  }

  .about-ecosystem__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    max-width: 640px;
  }

  .ecosystem-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-6);
    width: 100%;
  }

  .ecosystem-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-normal), border-color var(--duration-normal);
    grid-column: span 2;
  }

  .ecosystem-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-brand);
  }

  .ecosystem-card__logo {
    height: 40px;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
    margin-bottom: var(--space-4);
  }

  .ecosystem-card__logo--lindex {
    height: 48px;
    padding: 6px 12px;
    border-radius: var(--radius-md);
    background: #fff;
  }

  .ecosystem-card__wordmark {
    display: block;
    font-family: var(--font-brand);
    font-weight: var(--weight-bold);
    font-size: var(--text-3xl);
    letter-spacing: 0.01em;
    margin-bottom: var(--space-4);
  }

  .ecosystem-card__wordmark--minegocio {
    display: flex;
    flex-direction: column;
    gap: 2px;
    color: #59bdd7;
    line-height: 1;
  }

  .ecosystem-card__wordmark--minegocio small {
    font-family: var(--font-body);
    font-size: 0.68rem;
    font-weight: var(--weight-bold);
    letter-spacing: 0.16em;
  }

  .ecosystem-card__wordmark--minegocio strong {
    font-family: var(--font-brand);
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: var(--weight-semibold);
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .ecosystem-card--minegocio {
    background:
      radial-gradient(circle at 92% 8%, rgba(89, 189, 215, 0.14), transparent 38%),
      rgba(255, 255, 255, 0.03);
  }

  @media (max-width: 900px) {
    .ecosystem-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ecosystem-card {
      grid-column: span 1;
    }
  }

  @media (max-width: 640px) {
    .ecosystem-grid {
      grid-template-columns: 1fr;
    }

    .ecosystem-card {
      grid-column: span 1;
    }
  }

  .ecosystem-card h3 {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    font-weight: var(--weight-bold);
  }

  .ecosystem-card p {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
    margin-bottom: var(--space-4);
    flex-grow: 1;
  }

  .ecosystem-card__link {
    color: var(--color-brand);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: color var(--duration-fast);
  }

  .ecosystem-card__link:hover {
    color: var(--color-glow);
  }

  /* Vision */
  .about-vision {
    padding: var(--space-16) 0;
    background: rgba(255, 255, 255, 0.02);
    border-block: 1px solid var(--color-border);
  }

  .about-vision__inner {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .vision-text {
    font-size: var(--text-xl);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  /* Values */
  .about-values {
    padding: var(--space-20) 0;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-6);
  }

  .value-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--color-border);
    padding: var(--space-8);
    border-radius: var(--radius-lg);
    transition: transform var(--duration-normal);
  }

  .value-card:hover {
    transform: translateY(-5px);
    border-color: var(--color-brand);
  }

  .value-icon {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .value-card h3 {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
    font-weight: var(--weight-bold);
  }

  .value-card p {
    color: var(--color-text-muted);
    font-size: var(--text-base);
    line-height: 1.6;
  }

  /* Personality */
  .about-personality {
    padding: var(--space-20) 0;
    background: rgba(255, 255, 255, 0.02);
  }

  .personality-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-8);
    margin-bottom: var(--space-12);
  }

  .personality-card {
    padding: var(--space-6);
    border-left: 2px solid var(--color-brand);
    background: linear-gradient(
      to right,
      rgba(8, 145, 178, 0.05),
      transparent
    );
  }

  .personality-card h3 {
    font-size: var(--text-lg);
    color: var(--color-text);
    margin-bottom: var(--space-2);
  }

  .personality-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .brand-slogan {
    text-align: center;
    font-size: var(--text-3xl);
    font-weight: var(--weight-bold);
    color: var(--color-text);
    margin-top: var(--space-8);
    letter-spacing: -0.02em;
  }

  /* Tone */
  .about-tone {
    padding: var(--space-20) 0;
    text-align: center;
  }

  .about-tone__inner {
    max-width: 800px;
    margin: 0 auto;
  }

  .tone-text {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  /* CTA */
  .about-cta {
    padding: var(--space-20) 0;
    text-align: center;
    border-top: 1px solid var(--color-border);
  }

  .about-cta h2 {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-8);
  }

  .btn-primary {
    display: inline-block;
    background: var(--color-brand);
    color: white;
