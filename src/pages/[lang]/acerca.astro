---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import { useTranslations } from "../../i18n/utils";
import { getEnv, getTeamMembers, mediaUrl } from "../../lib/strapi";
import TeamConstellation from "../../components/ui/team-constellation";
import ContactForm from "../../components/sections/ContactForm.astro";

// SSR para que un integrante recien agregado en Strapi aparezca sin rebuild.
export const prerender = false;

const { lang: rawLang } = Astro.params;
const lang = rawLang === "en" ? "en" : "es";
const htmlLang = lang === "en" ? "en" : "es-MX";
const t = useTranslations(lang);
const contactCopy = lang === "es"
  ? {
      eyebrow: "CONSTRUYAMOS EL SIGUIENTE SISTEMA",
      title: "¿Qué necesita tu operación para avanzar?",
      text: "Cuéntanos el reto. Diseñamos el siguiente paso con producto, inteligencia, datos o desarrollo a medida.",
    }
  : {
      eyebrow: "LET'S BUILD THE NEXT SYSTEM",
      title: "What does your operation need to move forward?",
      text: "Tell us the challenge. We will design the next step with product, intelligence, data or custom development.",
    };

const titleMap = {
  es: "Acerca de Azury Labs — Inteligencia artificial aplicada y ARM",
  en: "About Azury Labs — Applied artificial intelligence and ARM",
};

const site = Astro.site ?? Astro.url;
const pageUrl = new URL(`/${lang}/acerca`, site).toString();
const homeUrl = new URL(`/${lang}/`, site).toString();
const aboutJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: titleMap[lang as keyof typeof titleMap],
      description: t("about.hero.subtitle"),
      inLanguage: htmlLang,
      isPartOf: { "@id": `${site}#website` },
      about: { "@id": `${site}#organization` },
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: lang === "es" ? "Inicio" : "Home", item: homeUrl },
        { "@type": "ListItem", position: 2, name: lang === "es" ? "Acerca de Azury Labs" : "About Azury Labs", item: pageUrl },
      ],
    },
  ],
};

const strapiBase = getEnv(Astro.locals, "STRAPI_URL").replace(/\/$/, "");
const teamMembers = await getTeamMembers({ locals: Astro.locals, lang });
const team = teamMembers.map((member) => ({
  src: member.avatar?.url ? mediaUrl(strapiBase, member.avatar.url) : "/images/logos/azurylabs-isotipo-white.png",
  alt: member.avatar?.alternativeText || member.name,
  title: member.name,
  role: member.role,
  bio: member.bio,
  href: `/${lang}/equipo/${member.slug}`,
  tags: ["Azury Labs", member.role].filter(Boolean),
}));

Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, s-maxage=300, stale-while-revalidate=600",
);
---

<BaseLayout
  title={titleMap[lang as keyof typeof titleMap]}
  description={t("about.hero.subtitle")}
  lang={htmlLang}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(aboutJsonLd)} />
  <Navbar lang={lang} page="about" showTeam={teamMembers.length > 0} />

  <main class="about-page">
    <section id="mision" class="about-hero">
      <div class="container about-hero__inner">
        <div class="about-hero__copy">
          <p class="about-hero__eyebrow"><span aria-hidden="true"></span>{t("nav.company")}</p>
          <h1 class="about-hero__title">{t("about.hero.title")}</h1>
          <p class="about-hero__subtitle">{t("about.hero.subtitle")}</p>
          <div class="about-hero__actions">
            <a class="about-hero__primary" href="#contacto">{lang === "es" ? "Hablemos de tu operación" : "Let's talk about your operation"}<span aria-hidden="true">↗</span></a>
            <a class="about-hero__contact-link" href={teamMembers.length ? "#equipo" : "#vision"}>
              {teamMembers.length ? (lang === "es" ? "Conoce al equipo" : "Meet the team") : (lang === "es" ? "Nuestra visión" : "Our vision")}<span aria-hidden="true">↓</span>
            </a>
          </div>
          <p class="about-hero__markets">México <span aria-hidden="true">·</span> Colombia <span aria-hidden="true">·</span> {lang === "es" ? "Estados Unidos" : "United States"}</p>
        </div>
        <aside class="about-hero__statement" aria-label={lang === "es" ? "Tesis Azury" : "Azury thesis"}>
          <div class="about-hero__statement-top">
            <span class="about-hero__statement-index">AZURY / {new Date().getFullYear()}</span>
            <img src="/images/logos/azurylabs-isotipo-white.png" alt="" width="64" height="64" />
          </div>
          <blockquote>{t("about.hero.quote")}</blockquote>
          <div class="about-hero__statement-lines" aria-hidden="true">
            <span>{lang === "es" ? "PRODUCTO" : "PRODUCT"}</span><span>{lang === "es" ? "IA" : "AI"}</span><span>{lang === "es" ? "DATOS" : "DATA"}</span><span>SOFTWARE</span>
          </div>
        </aside>
      </div>
    </section>

    <!-- Team Section -->
    {
      teamMembers.length > 0 && (
        <section id="equipo" class="about-team">
          <div class="container about-team__inner">
            <span class="badge">{t("about.team.badge")}</span>
            <h2 class="section-title">{t("about.team.title")}</h2>
            <p class="about-team__subtitle">{t("about.team.subtitle")}</p>

            <TeamConstellation client:load items={team} lang={lang} />
            <div class="team-directory" aria-label={lang === "es" ? "Directorio del equipo" : "Team directory"}>
              {teamMembers.map((member) => (
                <a href={`/${lang}/equipo/${member.slug}`}><span>{member.name}</span><small>{member.role}</small><span aria-hidden="true">↗</span></a>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- Vision Section -->
    <section id="vision" class="about-vision">
      <div class="container about-vision__inner">
        <span class="badge">{lang === "es" ? "HACIA DÓNDE VAMOS" : "WHERE WE'RE HEADED"}</span>
        <h2 class="section-title">{t("about.vision.title")}</h2>
        <p class="vision-text">{t("about.vision.text")}</p>
      </div>
    </section>

    <!-- Values Section -->
    <section id="valores" class="about-values">
      <div class="container">
        <header class="about-section-heading">
          <div><span class="badge">{lang === "es" ? "NUESTROS PRINCIPIOS" : "OUR PRINCIPLES"}</span><h2 class="section-title">{t("about.values.title")}</h2></div>
          <p>{lang === "es" ? "El criterio que guía cada producto, cada decisión y cada implementación." : "The principles behind every product, decision and implementation."}</p>
        </header>
        <div class="values-grid">
          <!-- Value 1 -->
          <div class="value-card">
            <span class="value-index" aria-hidden="true">01</span>
            <h3>{t("about.values.v1.title")}</h3>
            <p>{t("about.values.v1.desc")}</p>
          </div>
          <!-- Value 2 -->
          <div class="value-card">
            <span class="value-index" aria-hidden="true">02</span>
            <h3>{t("about.values.v2.title")}</h3>
            <p>{t("about.values.v2.desc")}</p>
          </div>
          <!-- Value 3 -->
          <div class="value-card">
            <span class="value-index" aria-hidden="true">03</span>
            <h3>{t("about.values.v3.title")}</h3>
            <p>{t("about.values.v3.desc")}</p>
          </div>
          <!-- Value 4 -->
          <div class="value-card">
            <span class="value-index" aria-hidden="true">04</span>
            <h3>{t("about.values.v4.title")}</h3>
            <p>{t("about.values.v4.desc")}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Brand Personality Section -->
    <section id="personalidad" class="about-personality">
      <div class="container">
        <h2 class="section-title">{lang === "es" ? "Nuestra manera de trabajar" : "How we work"}</h2>
        <div class="personality-grid">
          <div class="personality-card">
            <h3>{t("about.personality.items.p1.title")}</h3>
            <p>{t("about.personality.items.p1.desc")}</p>
          </div>
          <div class="personality-card">
            <h3>{t("about.personality.items.p2.title")}</h3>
            <p>{t("about.personality.items.p2.desc")}</p>
          </div>
          <div class="personality-card">
            <h3>{t("about.personality.items.p3.title")}</h3>
            <p>{t("about.personality.items.p3.desc")}</p>
          </div>
        </div>
        <p class="brand-slogan">{t("about.personality.slogan")}</p>
      </div>
    </section>

    <section id="contacto" class="about-contact">
      <div class="container about-contact__inner">
        <div class="about-contact__copy">
          <p class="about-contact__eyebrow"><span aria-hidden="true"></span>{contactCopy.eyebrow}</p>
          <h2>{contactCopy.title}</h2>
          <p>{contactCopy.text}</p>
          <a href={`/${lang}/contacto`} class="about-contact__route">
            {lang === "es" ? "Abrir página de contacto" : "Open contact page"} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <div class="about-contact__form">
          <ContactForm lang={lang} />
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>

<style>
  .about-page { padding-top: 80px; background: var(--color-bg); }
  .about-page section { scroll-margin-top: 100px; }
  .about-hero {
    padding-block: clamp(3.5rem, 7vw, 7rem);
    background: radial-gradient(ellipse at 85% 10%, rgba(8, 145, 178, 0.11), transparent 55%);
  }
  .about-hero__inner { display: grid; grid-template-columns: 1.25fr 0.75fr; align-items: center; gap: clamp(2rem, 6vw, 6rem); }
  .about-hero__eyebrow, .about-contact__eyebrow {
    display: flex; align-items: center; gap: 0.65rem; color: var(--color-glow);
    font-size: 0.72rem; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
  }
  .about-hero__eyebrow span, .about-contact__eyebrow span { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .about-hero__title { max-width: 16ch; margin-top: 1.3rem; font-size: clamp(2.9rem, 5.3vw, 5.1rem); font-weight: 700; letter-spacing: -0.055em; line-height: 1.04; text-wrap: balance; }
  .about-hero__subtitle { max-width: 58ch; margin-top: 1.7rem; font-size: clamp(1rem, 1.3vw, 1.13rem); line-height: 1.75; color: var(--color-text-muted); }
  .about-hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: 2rem; }
  .about-hero__primary { display: inline-flex; align-items: center; gap: 1rem; padding: 0.85rem 1.3rem; border-radius: 0.75rem; background: var(--color-brand); color: #fff; font-size: 0.88rem; font-weight: 650; text-decoration: none; }
  .about-hero__primary:hover { background: #087c99; }
  .about-hero__contact-link { display: inline-flex; gap: 0.6rem; color: var(--color-text); font-size: 0.85rem; font-weight: 600; text-decoration: none; }
  .about-hero__contact-link:hover { color: var(--color-glow); }
  .about-hero__markets { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-top: 2rem; color: var(--color-text-muted); font-size: 0.77rem; }
  .about-hero__markets span { color: var(--color-brand); }
  .about-hero__statement {
    display: flex; flex-direction: column; justify-content: space-between; gap: 2rem;
    min-height: 370px; padding: clamp(1.6rem, 3vw, 2.4rem); border: 1px solid rgba(0, 200, 255, 0.24); border-radius: 1.5rem;
    background: radial-gradient(circle at 100% 0%, #12425a, transparent 65%), #0d1b29;
  }
  .about-hero__statement-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; }
  .about-hero__statement-index { color: #81c5d8; font-size: 0.65rem; font-weight: 650; letter-spacing: 0.14em; }
  .about-hero__statement-top img { width: 54px; height: 54px; object-fit: contain; }
  .about-hero__statement blockquote { max-width: 13ch; margin: 0; color: #eaf4fb; font-size: clamp(1.8rem, 2.6vw, 2.7rem); font-weight: 650; line-height: 1.1; letter-spacing: -0.035em; }
  .about-hero__statement-lines { display: flex; flex-wrap: wrap; gap: 0.6rem; border-top: 1px solid #2b4654; padding-top: 1.3rem; }
  .about-hero__statement-lines span { color: #a3c4d3; font-size: 0.6rem; font-weight: 650; letter-spacing: 0.12em; }
  .badge { display: inline-block; color: var(--color-brand); font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; }
  .section-title { margin-top: 0.75rem; color: var(--color-text); font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; line-height: 1.1; letter-spacing: -0.04em; text-wrap: balance; }
  .about-section-heading { display: grid; grid-template-columns: 1fr 0.85fr; align-items: end; gap: 2rem; margin-bottom: 2.7rem; }
  .about-section-heading > p { max-width: 52ch; color: var(--color-text-muted); font-size: 1rem; line-height: 1.7; }
  .about-team { padding-block: clamp(3.5rem, 6vw, 5.5rem); border-top: 1px solid var(--color-border-subtle); }
  .about-team__subtitle { max-width: 58ch; margin-top: 1rem; margin-bottom: 2rem; color: var(--color-text-muted); line-height: 1.7; }
  .team-directory { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.5rem; margin-top: 2rem; }
  .team-directory a { position: relative; padding: 1rem 1.4rem 1rem 0; border-top: 1px solid var(--color-border-subtle); color: var(--color-text); text-decoration: none; }
  .team-directory a > span:first-child { display: block; font-size: 0.84rem; font-weight: 600; line-height: 1.5; }
  .team-directory small { display: block; margin-top: 0.3rem; font-size: 0.71rem; color: var(--color-text-muted); }
  .team-directory a > span:last-child { position: absolute; right: 0; top: 1rem; color: var(--color-brand); }
  .team-directory a:hover { color: var(--color-glow); }
  .team-directory a:focus-visible { outline: 2px solid var(--color-glow); outline-offset: 4px; }
  .about-vision { padding-block: clamp(3.5rem, 6vw, 6rem); border-block: 1px solid var(--color-border-subtle); background: var(--color-surface); }
  .about-vision .section-title { font-size: 1.25rem; margin-top: 0.8rem; color: var(--color-text-muted); }
  .vision-text { max-width: 42ch; margin-top: 1.4rem; color: var(--color-text); font-size: clamp(1.6rem, 2.8vw, 2.65rem); line-height: 1.4; letter-spacing: -0.025em; text-wrap: balance; }
  .about-values { padding-block: clamp(3.5rem, 6vw, 6rem); }
  .values-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.2rem; }
  .value-card { padding: 1.5rem; border: 1px solid var(--color-border-subtle); border-radius: 1rem; background: var(--color-surface); }
  .value-index { color: var(--color-brand); font-size: 0.72rem; font-weight: 650; letter-spacing: 0.12em; }
  .value-card h3 { margin-top: 1.5rem; font-size: 1.05rem; font-weight: 650; line-height: 1.4; }
  .value-card p { margin-top: 0.75rem; color: var(--color-text-muted); font-size: 0.86rem; line-height: 1.7; }
  .about-personality { padding-bottom: clamp(3.5rem, 6vw, 6rem); }
  .personality-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; margin-top: 2rem; }
  .personality-card { border-top: 1px solid var(--color-brand); padding-top: 1.25rem; }
  .personality-card h3 { font-size: 1rem; font-weight: 650; }
  .personality-card p { margin-top: 0.65rem; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.75; }
  .brand-slogan { margin-top: 3.5rem; font-size: clamp(1.3rem, 2vw, 2rem); color: var(--color-text); letter-spacing: -0.03em; font-weight: 600; }
  .about-contact { padding-block: clamp(3.5rem, 7vw, 7rem); border-top: 1px solid var(--color-border-subtle); }
  .about-contact__inner { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .about-contact__copy h2 { max-width: 16ch; margin-top: 1rem; font-size: clamp(2rem, 3.6vw, 3.3rem); line-height: 1.1; letter-spacing: -0.045em; text-wrap: balance; }
  .about-contact__copy > p:not(.about-contact__eyebrow) { max-width: 46ch; margin-top: 1.3rem; color: var(--color-text-muted); line-height: 1.7; }
  .about-contact__route { display: inline-flex; gap: 0.6rem; margin-top: 1.5rem; font-size: 0.85rem; font-weight: 600; color: var(--color-brand); text-decoration: none; }
  .about-contact__route:hover { color: var(--color-glow); }
  .about-contact__form { min-width: 0; padding: clamp(1.25rem, 3vw, 2.2rem); border: 1px solid var(--color-border-subtle); border-radius: 1.3rem; background: var(--color-surface); }
  :is(.about-hero__primary, .about-hero__contact-link, .about-contact__route):focus-visible { outline: 2px solid var(--color-glow); outline-offset: 5px; }
  @media (max-width: 1000px) {
    .values-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .about-hero__inner { grid-template-columns: 1.15fr 0.85fr; gap: 2rem; }
    .about-hero__statement { min-height: 330px; }
  }
  @media (max-width: 760px) {
    .about-hero__inner, .about-section-heading, .about-contact__inner { grid-template-columns: 1fr; }
    .about-hero__statement { min-height: 290px; }
    .about-hero__statement blockquote { max-width: 20ch; }
    .about-section-heading { gap: 1.2rem; margin-bottom: 2rem; }
    .personality-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .team-directory { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 540px) {
    .about-page { padding-top: 70px; }
    .about-hero__title { font-size: clamp(2.4rem, 10.5vw, 3.4rem); }
    .about-hero__actions { align-items: flex-start; flex-direction: column; }
    .values-grid, .team-directory { grid-template-columns: 1fr; }
    .about-hero__statement { border-radius: 1.1rem; }
    .about-hero__markets { font-size: 0.7rem; }
  }
</style>
