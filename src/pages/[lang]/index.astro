---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

import Navbar from "../../components/sections/Navbar.astro";
import Hero from "../../components/sections/Hero.astro";
import Products from "../../components/sections/Products.astro";
import Features from "../../components/sections/Features.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import Stats from "../../components/sections/Stats.astro";
import FAQ from "../../components/sections/FAQ.astro";
import CTA from "../../components/sections/CTA.astro";
import Footer from "../../components/sections/Footer.astro";
import { connectHref, trackingHref } from "../../lib/product-links";
import { useTranslations } from "../../i18n/utils";
import ChatWidget from "../../components/widgets/ChatWidget.astro";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const htmlLang = lang === "en" ? "en" : "es-MX";
const t = useTranslations(lang ?? "en");

const titleMap = {
  es: "Azury Labs — IA Aplicada, ARM (Sales OS) y Software a Medida",
  en: "Azury Labs — Applied AI, ARM (Sales OS) & Custom Software",
};

const descMap = {
  es: "Azury Labs LLC crea agentes de IA (Atenea), ARM omnicanal (Sales OS), ingeniería autónoma (Lindex), API de WhatsApp y software a medida para tu operación.",
  en: "Azury Labs LLC builds AI agents (Atenea), omnichannel ARM (Sales OS), autonomous engineering (Lindex), WhatsApp API and custom software for US businesses.",
};

const fullDescMap = {
  es: "Azury Labs LLC crea productos propios y soluciones de IA aplicada: Atenea (agentes de IA de mensajes y voz), Lindex (ingeniería autónoma), Sales OS (ARM — Agentic Relationship Management), Mi Negocio, CIEE, Systems, Connect y Tracking System.",
  en: "Azury Labs LLC builds applied AI products and custom software: Atenea (real-time messaging and voice AI agents), Lindex (autonomous software engineering), Sales OS (ARM — Agentic Relationship Management), Mi Negocio, CIEE, Systems, Connect and Tracking System.",
};

const site = Astro.site ?? Astro.url;
const pageUrl = new URL(`/${lang}/`, site).toString();
const orgId = `${site}#organization`;

const products = [
  {
    name: "Iruz Atenea",
    url: "https://atenea.iruzlabs.com",
    category: "AI agent platform",
    features: t("products.atenea.features"),
    description: lang === "en"
      ? "Platform to create AI agents that handle messages and voice in real time, connect to business systems and execute real processes."
      : "Plataforma para crear agentes de IA que atienden mensajes y voz en tiempo real, se conectan a los sistemas del negocio y ejecutan procesos reales.",
  },
  {
    name: "Iruz Lindex",
    url: "https://lindex.iruzlabs.com",
    category: "Autonomous software engineering harness",
    features: t("products.lindex.features"),
    description: lang === "en"
      ? "Harness that coordinates AI agents from ticket to code, tests and a deployed preview, with isolated execution, full traceability and per-task budget control."
      : "Harness que coordina agentes de IA del ticket al código, las pruebas y un preview desplegado, con ejecución aislada, trazabilidad y control de presupuesto por tarea.",
  },
  {
    name: "Iruz Sales OS",
    url: "https://crm.iruzlabs.com",
    category: "Agentic Relationship Management (ARM)",
    features: t("products.salesOs.features"),
    description: lang === "en"
      ? "Omnichannel Agentic Relationship Management (ARM) sales operating system that unites channels, AI agents and human teams to engage, qualify and advance every opportunity autonomously."
      : "Sistema operativo de ventas ARM (Agentic Relationship Management) omnicanal que conecta canales, agentes de IA y equipo humano para atender, calificar y hacer avanzar cada oportunidad de forma autónoma.",
  },
  {
    name: "Iruz Mi Negocio",
    url: `https://minegocio.iruzlabs.com/${lang}`,
    category: "Business management software",
    features: t("products.miNegocio.features"),
    description: lang === "en"
      ? "Customers, quotes, orders and follow-up in one simple operation for growing businesses."
      : "Clientes, cotizaciones, órdenes y seguimiento en una operación simple para negocios en crecimiento.",
  },
  {
    name: "Iruz CIEE",
    url: "https://ciee.iruzlabs.com",
    category: "Surveys and market research",
    features: t("products.ciee.features"),
    description: lang === "en"
      ? "AI-driven surveys, opinion studies and political or market polling."
      : "Encuestas con IA, estudios de opinión y sondeos políticos o de mercado.",
  },
  {
    name: "Iruz Connect",
    url: new URL(connectHref(lang), Astro.url).toString(),
    category: "WhatsApp Business API platform",
    features: t("products.connect.features"),
    description: lang === "en"
      ? "The official WhatsApp API for businesses and applications, without the technical complexity of Meta."
      : "La API oficial de WhatsApp para empresas y aplicaciones, sin la complejidad técnica de Meta.",
  },
  {
    name: "Iruz Tracking System",
    url: new URL(trackingHref(lang), Astro.url).toString(),
    category: "Product and campaign analytics",
    features: t("products.tracking.features"),
    description: lang === "en"
      ? "Product analytics that measures every step of the customer journey, from first contact to sale."
      : "Analítica de producto que mide cada paso del cliente, del primer contacto a la venta.",
  },
];

const homeJsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${pageUrl}#webpage`,
      url: pageUrl,
      name: titleMap[lang as keyof typeof titleMap],
      description: fullDescMap[lang as keyof typeof fullDescMap],
      inLanguage: htmlLang,
      isPartOf: { "@id": `${site}#website` },
      about: { "@id": orgId },
      speakable: {
        "@type": "SpeakableSpecification",
        cssSelector: [".hero__headline", ".hero__sub", ".faq__item"],
      },
    },
    {
      "@type": "ItemList",
      "@id": `${pageUrl}#products`,
      name: lang === "en" ? "Azury Labs products" : "Productos de Azury Labs",
      numberOfItems: products.length + 1,
      itemListElement: [
        ...products.map((product, index) => ({
          "@type": "ListItem",
          position: index + 1,
          item: {
            "@type": "SoftwareApplication",
            name: product.name,
            url: product.url,
            operatingSystem: "Web",
            applicationCategory: "BusinessApplication",
            applicationSubCategory: product.category,
            description: product.description,
            ...(Array.isArray(product.features) && { featureList: product.features }),
            publisher: { "@id": orgId },
          },
        })),
        {
          "@type": "ListItem",
          position: products.length + 1,
          item: {
            "@type": "Service",
            name: "Iruz Systems",
            url: "https://systems.iruzlabs.com",
            serviceType: lang === "en"
              ? "Custom software development and technology consulting"
              : "Desarrollo de software a medida y consultoría tecnológica",
            provider: { "@id": orgId },
          },
        },
      ],
    },
  ],
};
---

<BaseLayout
  title={titleMap[lang as keyof typeof titleMap]}
  description={descMap[lang as keyof typeof descMap]}
  lang={htmlLang}
>
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(homeJsonLd)} />
  <Navbar lang={lang} />
  <main>
    <Hero lang={lang} />
    <Products lang={lang} />
    <Features lang={lang} />
    <HowItWorks lang={lang} />
    <Stats lang={lang} />
    <FAQ lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
  <ChatWidget lang={lang} />
</BaseLayout>
