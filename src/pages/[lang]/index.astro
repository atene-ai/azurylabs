---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

import Navbar from "../../components/sections/Navbar.astro";
import Hero from "../../components/sections/Hero.astro";
import Products from "../../components/sections/Products.astro";
import Features from "../../components/sections/Features.astro";
import HowItWorks from "../../components/sections/HowItWorks.astro";
import Stats from "../../components/sections/Stats.astro";
import CTA from "../../components/sections/CTA.astro";
import Footer from "../../components/sections/Footer.astro";

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const htmlLang = lang === "en" ? "en" : "es-MX";

const titleMap = {
  es: "Azury Labs — Inteligencia artificial aplicada, productos y soluciones a medida",
  en: "Azury Labs — Applied AI, products and custom solutions",
};

const descMap = {
  es: "Azury Labs crea productos propios y soluciones de inteligencia artificial aplicada para que las empresas vendan más, operen mejor y tomen decisiones con datos.",
  en: "Azury Labs creates its own applied artificial intelligence products and custom solutions so companies can sell more, operate better and make data-driven decisions.",
};
---

<BaseLayout
  title={titleMap[lang as keyof typeof titleMap]}
  description={descMap[lang as keyof typeof descMap]}
  lang={htmlLang}
>
  <Navbar lang={lang} />
  <main>
    <Hero lang={lang} />
    <Products lang={lang} />
    <Features lang={lang} />
    <HowItWorks lang={lang} />
    <Stats lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
