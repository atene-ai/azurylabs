---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/sections/Navbar.astro";
import Footer from "../../components/sections/Footer.astro";
import { useTranslations } from "../../i18n/utils";

export const prerender = true;

export function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "en" } }];
}

const { lang } = Astro.params;
const htmlLang = lang === "en" ? "en" : "es-MX";
const t = useTranslations(lang);
const lastUpdated =
  lang === "es" ? "6 de octubre de 2026" : "October 6, 2026";

const title =
  lang === "es"
    ? "Términos y Condiciones — Azury Labs LLC"
    : "Terms and Conditions — Azury Labs LLC";
const desc =
  lang === "es"
    ? "Términos y Condiciones de uso de Azury Labs LLC."
    : "Terms and Conditions of use for Azury Labs LLC.";
